              "queryRef": "Sum(FACT YS10N Open.Net value)",
              "nativeQueryRef": "Sum of Net value",
              "hidden": true
            },
            {
              "field": {
                "Aggregation": {
                  "Expression": {
                    "Column": {
                      "Expression": {
                        "SourceRef": {
                          "Entity": "FACT EDB Budget- Finance"
                        }
                      },
                      "Property": "Customer Demand Net sales _APO_"
                    }
                  },
                  "Function": 0
                }
              },
              "queryRef": "Sum(FACT EDB Budget- Finance.Customer Demand Net sales _APO_)",
              "nativeQueryRef": "Sum of Customer Demand Net sales _APO_",
              "hidden": true
            },
            {
              "field": {
                "NativeVisualCalculation": {
                  "Language": "dax",
                  "Expression": "\r\nIF(\r\n    MAX([Full Date]) = TODAY(),\r\n    BLANK(),\r\n    VAR CurrentDate = MAX([Full Date])\r\n\r\n    VAR WorkingDaysElapsedRaw =\r\n        CALCULATE(\r\n            COUNTROWS(VALUES([Full Date])),\r\n            FILTER(\r\n                ALL([Full Date]),\r\n                [Full Date] <= CurrentDate &&\r\n                WEEKDAY([Full Date], 2) <= 5\r\n            )\r\n        )\r\n\r\n    VAR WorkingDaysElapsed =\r\n        MAX(1, WorkingDaysElapsedRaw)\r\n\r\n    VAR TotalWorkingDaysInMonth =\r\n        CALCULATE(\r\n            COUNTROWS(VALUES([Full Date])),\r\n            FILTER(\r\n                ALL([Full Date]),\r\n                MONTH([Full Date]) = MONTH(CurrentDate) &&\r\n                YEAR([Full Date]) = YEAR(CurrentDate) &&\r\n                WEEKDAY([Full Date], 2) <= 5\r\n            )\r\n        )\r\n\r\n    RETURN\r\n        IF(\r\n            WorkingDaysElapsed = 1,\r\n            [Sum of Customer Demand Net sales _APO_],\r\n            [Actuals] / (WorkingDaysElapsed / TotalWorkingDaysInMonth)\r\n        )\r\n)",
                  "Name": "Run Rate"
                }
              },
              "queryRef": "select7",
              "nativeQueryRef": "Run Rate",
              "hidden": true
            },
            {
              "field": {
                "NativeVisualCalculation": {
                  "Language": "dax",
                  "Expression": "MOVINGAVERAGE([Run Rate], 14)",
                  "Name": "RR Moving Average"
                }
              },
              "queryRef": "select6",
              "nativeQueryRef": "RR Moving Average"
            },
            {
              "field": {
                "NativeVisualCalculation": {
                  "Language": "dax",
                  "Expression": "\r\nVAR CurrentDate = MAX([Full Date])\r\nRETURN\r\n    CALCULATE(\r\n        COUNTROWS(VALUES([Full Date])),\r\n        FILTER(\r\n            ALL([Full Date]),\r\n            [Full Date] <= CurrentDate &&\r\n            WEEKDAY([Full Date],2) <= 5\r\n        )\r\n    )",
                  "Name": "Test WD Elapsed"
                }
              },
              "queryRef": "select8",
              "nativeQueryRef": "Test WD Elapsed",
              "hidden": true
            }
