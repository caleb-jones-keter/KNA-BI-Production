              "queryRef": "Sum(FACT YS10N Past.Net Value USD)",
              "nativeQueryRef": "Sum of Net Value USD",
              "hidden": true
            },
            {
              "field": {
                "NativeVisualCalculation": {
                  "Language": "dax",
                  "Expression": "if([Full Date]=today(),blank(),\r\nIF (\r\n    MAX([Full Date]) > TODAY(),\r\n    BLANK(),\r\n    RUNNINGSUM([Sum of Net Value USD])\r\n))",
                  "Name": "Actuals"
                }
              },
              "queryRef": "select",
              "nativeQueryRef": "Actuals",
              "format": "\\$#,0.00;(\\$#,0.00);\\$#,0.00"
            },
            {
              "field": {
                "NativeVisualCalculation": {
                  "Language": "dax",
                  "Expression": "runningsum([Sum of Net value])",
                  "Name": "Open Orders"
                }
              },
              "queryRef": "select5",
              "nativeQueryRef": "Open Orders",
              "hidden": true
            },
            {
              "field": {
                "NativeVisualCalculation": {
                  "Language": "dax",
                  "Expression": "if([Full Date]=today(),BLANK(),\nIF(\n    DAY(MAX([Full Date])) =1,\n    [Sum of Customer Demand Net sales _APO_],\n    [Actuals] / ((DAY(MAX([Full Date]))-0)  / DAY(EOMONTH(MAX([Full Date]), 0)))\n))",
                  "Name": "RunRate"
                }
              },
              "queryRef": "select4",
              "nativeQueryRef": "RunRate",
              "hidden": true
            },
            {
              "field": {
                "NativeVisualCalculation": {
                  "Language": "dax",
                  "Expression": "RUNNINGSUM([_$Selected Budget APO daily])",
                  "Name": "Customer Demand APO"
