table 'FACT YS10N'
	lineageTag: e78cb7b8-4479-4793-bd99-ebb8a7e7e078
	sourceLineageTag: [dbo].[FACT YS10N]

	measure TL = IF(MAX('DIM Product'[TL Qty])>0,SUM('FACT YS10N'[Order Qty])/MAX('DIM Product'[TL Qty]))
		lineageTag: 3a51112e-10c0-4238-9dc2-9dce2a4545d0

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total TL' = ```
			
			SUMX(
			    VALUES('DIM Product'[Material]),  -- iterate over each product in the current context
			    VAR TLQty = MAX('DIM Product'[TL Qty])
			    VAR OrderQty = SUM('FACT YS10N'[Order Qty])
			    VAR OnTimeDate = MAX('DIM Date'[Full Date])
			    VAR MaxDate = DATE(YEAR(TODAY()),12,31)
			    RETURN
			        IF(TLQty > 0, 
			            IF(MAX('FACT YS10N'[Fact Service Level.On Time date]) in DATESBETWEEN('DIM Date'[Full Date],OnTimeDate,MaxDate),OrderQty / TLQty)
			        )
			)
			```
		lineageTag: 1435725f-cf62-4497-b065-702d29236949

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'TL by Day' =
			
			VAR MaxDate = DATE(YEAR(TODAY()),12,31)
			VAR MinDate = MAX('DIM Date'[Full Date])
			RETURN
			
			CALCULATE([Total TL],DATESBETWEEN('DIM Date'[Full Date],MinDate,MaxDate))
		lineageTag: 79d5872b-f2ef-48f7-a94e-7fb8369fba80

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

