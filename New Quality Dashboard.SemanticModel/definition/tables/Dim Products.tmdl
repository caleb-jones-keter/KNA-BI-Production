	column 'New Market Group' =
			
			
			VAR test = LOWER(TRIM(SUBSTITUTE('Dim Products'[MARKET GROUP],"&"," ")))
			VAR _lastName =
			    MID (
			        test,
			        SEARCH ( " ", test, 1, 1 ),
			        LEN ( test ) - 1
			    )
			VAR _firstName =
			    MID ( test, 1, SEARCH ( " ", test, 1, 1 ) - 1 )
			RETURN
			    SUBSTITUTE(IFERROR(
			        UPPER ( LEFT ( _firstName, 1 ) )
			            & RIGHT ( _firstName, LEN ( _firstName ) - 1 ) & " "
			            & UPPER ( LEFT ( TRIM ( _lastName ), 1 ) )
			            & RIGHT ( TRIM ( _lastName ), LEN ( TRIM ( _lastName ) ) - 1 ),
			        IFERROR(
			            UPPER ( LEFT (test, 1 ) )
			                & RIGHT ( test, LEN ( test ) - 1 ),""))," "," & ")
		lineageTag: 963ecee1-e4f0-4aaa-bae9-efd24717540a
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column 'No Sales Filter' = IF([Sales (12M,-3M)]<=0,"No Sales","Sales")
