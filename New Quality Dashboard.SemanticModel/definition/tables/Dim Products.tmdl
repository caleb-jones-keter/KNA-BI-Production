table 'Dim Products'
	lineageTag: 58c747aa-e063-4781-9a07-2df13554862f

	measure 'TL % and YS10N RTV % correlation for MARKET GROUP' =
			
			VAR __CORRELATION_TABLE = VALUES('Dim Products'[MARKET GROUP])
			VAR __COUNT =
				COUNTX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([TL %] * [RTV %])
				)
			VAR __SUM_X = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([TL %]))
			VAR __SUM_Y = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([RTV %]))
			VAR __SUM_XY =
				SUMX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([TL %] * [RTV %] * 1.)
				)
			VAR __SUM_X2 = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([TL %] ^ 2))
			VAR __SUM_Y2 = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([RTV %] ^ 2))
			RETURN
				ABS(DIVIDE(
					__COUNT * __SUM_XY - __SUM_X * __SUM_Y * 1.,
					SQRT(
						(__COUNT * __SUM_X2 - __SUM_X ^ 2)
							* (__COUNT * __SUM_Y2 - __SUM_Y ^ 2)
					)
				))
		lineageTag: 19ceac73-715e-499e-9c95-6809a08b8e46

		extendedProperty MeasureTemplate =
				{
				  "version": 0,
				  "daxTemplateName": "CorrelationCoefficient"
				}

		annotation PBI_FormatHint = {"isGeneralNumber":true}

