	measure 'Defect % and TL % correlation for New Customer Group' =
			
			VAR __CORRELATION_TABLE = VALUES('Dim Customer Group'[New Customer Group])
			VAR __COUNT =
				COUNTX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([RTV %] * [TL %])
				)
			VAR __SUM_X = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([RTV %]))
			VAR __SUM_Y = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([TL %]))
			VAR __SUM_XY =
				SUMX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([RTV %] * [TL %] * 1.)
				)
			VAR __SUM_X2 =
				SUMX(
					KEEPFILTERS(__CORRELATION_TABLE),
					CALCULATE([RTV %] ^ 2)
				)
			VAR __SUM_Y2 = SUMX(KEEPFILTERS(__CORRELATION_TABLE), CALCULATE([TL %] ^ 2))
			RETURN
			    ABS(
			        DIVIDE(
			            __COUNT * __SUM_XY - __SUM_X * __SUM_Y * 1.,
			            SQRT(
			                (__COUNT * __SUM_X2 - __SUM_X ^ 2)
			                    * (__COUNT * __SUM_Y2 - __SUM_Y ^ 2)
			            )
			        )
			    )
