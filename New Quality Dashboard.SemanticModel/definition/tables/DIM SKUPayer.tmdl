table 'DIM SKUPayer'
	lineageTag: 642fea71-a80d-4a77-b0c0-a9b85eee4db1

	measure 'TL % and YS10N Defect % correlation for ITEM GROUP' = ```
			
			VAR __CORRELATION_TABLE = VALUES('Dim Products'[ITEM GROUP])
			VAR __COUNT =
			    COUNTROWS(__CORRELATION_TABLE)
			VAR __SUM_X =
			    SUMX(
			        KEEPFILTERS(__CORRELATION_TABLE),
			        VALUE(COALESCE([TL %], 0))
			    )
			VAR __SUM_Y =
			    SUMX(
			        KEEPFILTERS(__CORRELATION_TABLE),
			        VALUE(COALESCE([YS10N COPQ %], 0))
			    )
			VAR __SUM_XY =
			    SUMX(
			        KEEPFILTERS(__CORRELATION_TABLE),
			        VALUE(COALESCE([TL %], 0)) * VALUE(COALESCE([YS10N COPQ %], 0))
			    )
			VAR __SUM_X2 =
			    SUMX(
			        KEEPFILTERS(__CORRELATION_TABLE),
			        POWER(VALUE(COALESCE([TL %], 0)), 2)
			    )
			VAR __SUM_Y2 =
			    SUMX(
			        KEEPFILTERS(__CORRELATION_TABLE),
			        POWER(VALUE(COALESCE([YS10N COPQ %], 0)), 2)
			    )
			VAR __DENOM =
			    SQRT(
			        (__COUNT * __SUM_X2 - __SUM_X ^ 2) *
			        (__COUNT * __SUM_Y2 - __SUM_Y ^ 2)
			    )
			RETURN
			IF(
			    __DENOM = 0 || ISBLANK(__DENOM),
			    BLANK(),
			    DIVIDE(
			        __COUNT * __SUM_XY - (__SUM_X * __SUM_Y),
			        __DENOM
			    )
			)
			
			
			```
		lineageTag: 9a783837-c4b0-4be9-97c0-0eeab1d96858

