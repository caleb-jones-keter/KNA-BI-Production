table 'dbo FACT YS10N'
	lineageTag: 4f112329-deec-471e-addb-bcb0c1ca1673
	sourceLineageTag: [dbo].[FACT YS10N]

	measure '# YS10N Months 2' = CALCULATE(COUNTX(VALUES('Dates Table'[Month In Year]),SUM('dbo FACT YS10N'[Net value])),DATESINPERIOD('Dates Table'[Full Date],ENDOFMONTH('Dates Table'[Full Date]),-15,MONTH),'dbo FACT YS10N'[Net value]>0)-CALCULATE(COUNTX(VALUES('Dates Table'[Month In Year]),SUM('dbo FACT YS10N'[Net value])),DATESINPERIOD('Dates Table'[Full Date],ENDOFMONTH('Dates Table'[Full Date]),-3,MONTH))
		formatString: 0
		lineageTag: 268380fa-01d6-4188-86e5-b7aa927f8842

		changedProperty = Name

	measure '% Better 2' = FORMAT([Below Std % 2],"00%")&" Better"
		lineageTag: 21ef60e3-edc7-4375-9d52-e7024d3632fc

		changedProperty = Name

	measure 'Available RTV 2' = [RTV (12M) 2]-[RTV Below Std 2]
		lineageTag: fb7884b0-c8e4-47ab-8d68-d1ee37e19db4

		changedProperty = Name

	measure 'Below Std % 2' = ([RTV Below Std 2]/[RTV (12M) 2])
		lineageTag: a6c7270c-cc4d-4687-accd-87a03e96b048

		changedProperty = Name

	measure 'ECOM % 2' = IF([Sales (12M,-3M) 2]>0,MAX(0,[ECOM $ 12M 2]/[Sales (12M,-3M) 2]))
		lineageTag: 8bdcc376-d655-4448-b2de-0bbf6bfadba2

		changedProperty = Name

	measure 'ECOM $ 12M 2' = CALCULATE(SUM('dbo FACT YS10N'[ECOM $]),DATESINPERIOD('Dates Table'[Full Date],ENDOFMONTH('Dates Table'[Full Date]),-15,MONTH))- CALCULATE(SUM('dbo FACT YS10N'[ECOM $]),DATESINPERIOD('Dates Table'[Full Date],ENDOFMONTH('Dates Table'[Full Date]),-3,MONTH))
		lineageTag: 9cf028ef-8eaa-43cc-8e49-298db34d3fe5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Est. Defect % 2' = IF('dbo FACT YS10N'[RTV %]>0,([TL % 2])*-0.087+ 0.0886)
		lineageTag: 087f4791-9340-4582-ba09-44e19a36a14f

		changedProperty = Name

	measure 'Inclusion 2' = [RTV (12M) 2]+[Sales (12M,-3M) 2]
		lineageTag: ed467174-04c0-4296-8f42-158b77d32c50

		changedProperty = Name

	measure 'Just % Better 2' = FORMAT([Below Std % 2],"00%")
		lineageTag: 1361f44c-1879-4575-b436-e0653274ba09

		changedProperty = Name

	measure 'Opportunity RTV 2' = ([RTV % 2]-MAX([Est. Defect % 2],[Std Defect % 2]))*[Sales (12M,-3M) 2]
		lineageTag: 53c024b8-8667-4389-8abf-d2d38697f828

		changedProperty = Name

	measure 'Parcel % 2' = [Parcel $ 12M 2]/[Sales (12M,-3M) 2]
		lineageTag: 20febc73-37d1-44de-9102-1cd4c4c3e7f7

		changedProperty = Name

	measure 'Parcel $ 12M 2' = CALCULATE(SUM('dbo FACT YS10N'[Parcel $]),DATESINPERIOD('Dates Table'[Full Date],ENDOFMONTH('Dates Table'[Full Date]),-15,MONTH))- CALCULATE(SUM('dbo FACT YS10N'[Parcel $]),DATESINPERIOD('Dates Table'[Full Date],ENDOFMONTH('Dates Table'[Full Date]),-3,MONTH))
		lineageTag: 9e48d537-bcdd-4001-a393-8fb6477ad0ec

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

