	column _$Shipmentnumber =
			
			IF(ISBLANK('0125'[Shipment Number]),
			VAR CurrentSO = '0125'[Sales Order]
			
			VAR FilteredTable =
			    FILTER(
			        '0125',
			        '0125'[Sales Order] = CurrentSO &&
			        NOT(ISBLANK('0125'[Shipment Number]))
			    )
			VAR DelivNum = MAXX(FilteredTable, '0125'[Shipment Number])
			RETURN
			    IF(ISBLANK(DelivNum),'0125'[Sales Order],DelivNum),
			    '0125'[Shipment Number]
			)
		formatString: 0
