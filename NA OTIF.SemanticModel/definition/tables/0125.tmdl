			defaultHierarchy: LocalDateTable_3efdb083-e34e-4548-8bd8-48fcafb25796.'Date Hierarchy'

		annotation SummarizationSetBy = Automatic

	column _!PastDueNotShipped = IF(NOT(LEN([Reason for rejection])>0),IF(AND(ISBLANK([_!ShipDate]),NOW()>[_!LateDate]),1))
		formatString: 0
		lineageTag: bef09933-1095-401b-9c74-caf92bbbe294
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column _!OtifLine = IF(RELATED(RfR[Valid Orders])<>"NO",IF('0125'[_!SpareParts]="Finished Goods",IF('0125'[_!ActiveFilter]=0,IF('0125'[Payer name]<>"Samples",IF('0125'[Payer name]<>"Sample",IF('0125'[Payer name]<>"Keter Canada Inc. - Import",IF('0125'[Storage Location]<>"367J",IF([_!NotOnTime]>0,"NOT OTIF",IF([_!NotInFull],"NOT OTIF","OTIF")))))))))
		lineageTag: 58d88514-29c5-4176-9a90-d44cc7e23eae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _!Reason = IF(LEN([Reason for rejection])>0,"Cut - " & RELATED(RfR[SAP Text]),IF([_!ShippedLate]>0,IF(LEN([Load Delay Reason])>0,"Late - "&RELATED('Delay Reasons'[Delay Reason]),IF(AND('0125'[Shipping type]=7,'0125'[_!Variance]=1),"Late - Parcel (1 Day)",IF('0125'[Shipping type]=7,"Late - Parcel (> 1 Day)",IF('0125'[_!NeedsCode]="Needs Code","Late - Needs Code", "Late - Other")))),IF([_!ShippedEarly]>0,"Early - Shipped Early",IF([_!PastDueNotShipped]>0,IF(LEN([Load Delay Reason])>0,"Late - "&RELATED('Delay Reasons'[Delay Reason]),"Late - Past Due, Not Shipped")))))
		lineageTag: 62e43611-80c8-40a8-b3fd-4c1c67f48927
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _!OrderCut = IF(LEN([Reason for rejection])>0,1)
		formatString: 0
		lineageTag: 1ef91fe6-ff1a-44a7-bf67-9d8807ca59b8
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Column (Total Issues)' = '0125'[_!ShippedEarly]+'0125'[_!ShippedLate]+'0125'[_!PastDueNotShipped]+'0125'[_!OrderCut]
		formatString: 0
		lineageTag: 9da4a14f-99d1-4fd6-84c8-8de268e41208
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column _!NotOnTime = IF(RELATED('Delay Reasons'[On-time?])=1,0,IF('0125'[_!ShippedEarly]+[_!ShippedLate]+'0125'[_!PastDueNotShipped]>0,1,0))
		formatString: 0
		lineageTag: 5b0154cc-335d-434b-a7c4-7283c3c5eaf7
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column _!NotInFull = IF('0125'[_!OrderCut]>0,1,0)
		formatString: 0
		lineageTag: 157109a1-c587-41f3-b792-ecf552d27c12
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column _!LateGroup = IF('0125'[_!Variance]=1,"One Day Late",IF('0125'[_!Variance]<=7,"One Week Late",IF('0125'[_!Variance]<=30, "Multiple Weeks Late","One Month or More Late")))
		lineageTag: c5b5ea34-feb6-4bc9-b07e-69dc83a1a72d
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _!FillRate = IF(RELATED(RfR[Valid Orders])<>"NO",IF('0125'[_!SpareParts]="Finished Goods",IF('0125'[_!ActiveFilter]=0,IF('0125'[Payer name]<>"Samples",IF('0125'[Payer name]<>"Sample",IF('0125'[Payer name]<>"Keter Canada Inc. - Import",IF('0125'[Storage Location]<>"367J",IF('0125'[_!NotInFull]>0,"NOT FILL RATE",IF(ISBLANK('0125'[_!ShipDate]),"EXCLUDE","FILL RATE")))))))))
		lineageTag: ed317b32-f144-4998-a6a0-133dd1dfcfae
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _!OTS = IF(RELATED(RfR[Valid Orders])<>"NO",IF('0125'[_!SpareParts]="Finished Goods",IF('0125'[_!ActiveFilter]=0,IF('0125'[Payer name]<>"Samples",IF('0125'[Payer name]<>"Sample",IF('0125'[Payer name]<>"Keter Canada Inc. - Import",IF('0125'[Storage Location]<>"367J",IF([_!NotOnTime]>0,"NOT OTD","OTD"))))))))
		lineageTag: a4d88e36-e6c0-47c7-8146-0f9b73cf19be
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

