	measure 'Below Expectation' =
			
			IF(
			    NOT(HASONEVALUE('0125'[Plant])),
			    .91,
			    IF(
			        MAX('0125'[Plant])=66,
			        .96,
			        IF(
			            MAX('0125'[Plant])=67,
			            .89,
			            IF(
			                MAX('0125'[Plant])=73,
			                .89,
			                IF(
			                    MAX('0125'[Plant])=65,
			                    .95,
			                    0
			                )
			            )
			        )+
			        IF(QUARTER(MAX('0125'[_!OnTimeDate]))=1,-.03)+
			        IF(QUARTER(MAX('0125'[_!OnTimeDate]))=2,-.02)+
			        IF(QUARTER(MAX('0125'[_!OnTimeDate]))=3,-.01)
			    )
			)
		formatString: 0%;-0%;0%
		lineageTag: 44cfdae2-4fbe-4e9c-8329-4454cb833124

