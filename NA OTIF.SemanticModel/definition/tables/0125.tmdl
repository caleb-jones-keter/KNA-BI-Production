	column _!ShipDate = IF(NOT(ISBLANK([Act. Gds Mvmnt Date])),[Act. Gds Mvmnt Date],IF(NOT(ISBLANK([Invoice Billing Date])),[Invoice Billing Date]))
		formatString: Short Date
		lineageTag: 0ecabecf-75f4-4ad5-aa93-03e779145c07
