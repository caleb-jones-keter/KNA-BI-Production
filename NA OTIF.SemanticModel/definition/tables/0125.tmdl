	measure _$FinesProjectionRemoveAmazon = ```
			
			SUMX(
			    '0125',
			    IF(
			        AND(
			            '0125'[Payer] = 150361,
			            '0125'[Reason for rejection] = "07"
			        ),
			        BLANK(),
			        IF(
			            AND(
			                '0125'[Payer] = 148600,
			                '0125'[Reason for rejection] = "07"
			            ),
			            BLANK(),
			            [_$FinesPredictionCuts]
			        )
			    )
			)
			 
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: a32c2c9a-0354-490a-b5fc-56967f41dbcc

	measure _$FinesPredictionCuts =
			VAR __table = SUMMARIZE('0125','0125'[Payer],"__value",[_$FinesPredictionCalculationCuts])
			RETURN
