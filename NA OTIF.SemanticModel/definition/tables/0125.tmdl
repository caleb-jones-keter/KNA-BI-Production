	measure 'Sum 3 Day Net Value' = ```
			
			
			VAR MinVisibleDate =
			    MINX ( ALLSELECTED ( Dates[Date] ), Dates[Date] )
			
			VAR MaxVisibleDate =
			    MAXX ( ALLSELECTED ( Dates[Date] ), Dates[Date] )
			
			VAR DateWindow =
			    FILTER (
			        ALL ( Dates[Date] ),
			        Dates[Date] >= MinVisibleDate
			            && Dates[Date] <= MaxVisibleDate
			    )
			
			RETURN
			    SUMX (
			        DateWindow,
			        CALCULATE (
			            [Initial Net Value],
			            DATESINPERIOD (
			                Dates[Date],
			                Dates[Date],
			                -3,
			                DAY
			            )
			        )
			    )
			
			```
		lineageTag: 1b6b5b97-e64c-4cc8-b526-1ca59bcc255f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max 3 Day Net Value' = ```
			
			MAXX (
			    ALLSELECTED ( 'Dates'[Date] ),
			    [Sum 3 Day Net Value]
			)
			
			
			```
		lineageTag: 83c47158-95b9-4f97-a6f1-b7b54e748b5c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

