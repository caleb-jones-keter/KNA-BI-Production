	column _$Avg_DHLOrderToShip = ```
			
			VAR GoodsDate = '0125'[Act. Gds Mvmnt Date]
			VAR StartDate =
			    IF(
			        '0125'[Storage Location] = "4674",
			        '0125'[SO Created Date],
			        '0125'[Delivery Creation Date]
			    )
			RETURN
			IF(
			    NOT(ISBLANK(GoodsDate)) && NOT(ISBLANK(StartDate)),
			    ROUND(DATEDIFF(StartDate, GoodsDate, DAY), 0),
			    BLANK()
			)
			
			```
