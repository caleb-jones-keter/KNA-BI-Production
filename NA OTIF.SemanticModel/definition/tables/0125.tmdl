			defaultHierarchy: LocalDateTable_25ce0ecb-e940-478c-877b-53f18e7283b3.'Date Hierarchy'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

