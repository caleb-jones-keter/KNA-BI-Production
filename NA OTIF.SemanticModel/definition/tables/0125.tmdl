	measure 'Redistributed Count' =
			
			VAR BlankCount =
			    CALCULATE(
			        COUNTROWS('0125'),
			        ISBLANK('0125'[_!Reason])
			    )
			VAR ProportionalBlank =
			    BlankCount * [ProportionPerReason]
			RETURN
			    COUNTROWS('0125') + ProportionalBlank
		formatString: 0
		lineageTag: b8a90aa2-b383-4f89-9f2b-1c1faec90551

	measure ProportionPerReason =
			
			DIVIDE(
			    COUNTROWS('0125'),
			    CALCULATE(
			        COUNTROWS('0125'),
			        NOT ISBLANK('0125'[_!Reason])
			    )
			)
		lineageTag: b8e35b5f-f54a-478d-92a1-735563a47f58

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure ParetoPercentage =
			
			VAR TotalRedistributed =
			    SUMX(
			        ALL('0125'[_!Reason]),
			        [Redistributed Count]
			    )
			RETURN
			    DIVIDE(
			        SUMX(
			            FILTER(
			                ALL('0125'[_!Reason]),
			                '0125'[_!Reason] <= MAX('0125'[_!Reason])
			            ),
			            [Redistributed Count]
			        ),
			        TotalRedistributed
			    )
		lineageTag: 337abf15-cfba-454c-a8db-d0f8e61a40c7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

