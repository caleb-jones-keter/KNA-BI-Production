		lineageTag: 39e7a44d-d614-4bb5-8974-254e96dcf07c
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _!OtifSO = IF(LEN('0125'[_!OtifLine])>0,IF(CALCULATE(COUNT('0125'[Sales Order]),FILTER(ALLEXCEPT('0125','0125'[Sales Order]),'0125'[_!OtifLine]="NOT OTIF"))>0,"NOT OTIF","OTIF"))
