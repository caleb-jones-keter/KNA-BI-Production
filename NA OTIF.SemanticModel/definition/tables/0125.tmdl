	column _!OtsDetail = IF(RELATED(RfR[Valid Orders])<>"NO",IF([_!NotOnTime]>0,IF('0125'[_!ShippedEarly]>0,"EARLY",IF(OR('0125'[_!PastDueNotShipped]>0,'0125'[_!ShippedLate]>0),"LATE")),"ON TIME"))
		lineageTag: a21fff2b-8735-44a6-b28e-44129fdd5388
