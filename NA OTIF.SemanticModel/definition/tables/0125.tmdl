	column _!MwkShipDate =
			
			
			VAR CurrentSO = '0125'[Sales Order]
			VAR CurrentLoc = '0125'[Storage Location]
			
			VAR FilteredTable =
			    FILTER(
			        '0125',
			        '0125'[Sales Order] = CurrentSO &&
			        '0125'[Storage Location] = CurrentLoc &&
			        NOT(ISBLANK('0125'[Delivery]))
			    )
			
			VAR NewShip = MAXX(FilteredTable, '0125'[_!ShipDate])
			RETURN
			
			IF('0125'[_!OrderCut]=1,
			    IF(ISBLANK('0125'[_!ShipDate]),
			        IF(ISBLANK(NewShip),'0125'[_!LateDate],NewShip),
			        '0125'[_!ShipDate]
			    ),
			    '0125'[_!ShipDate]
			)
		dataType: dateTime
		formatString: Short Date
		lineageTag: 962c3426-284e-43f7-9c2f-3f4b5e71662c
		summarizeBy: none

		variation Variation
			isDefault
			relationship: b96d5985-3caa-4860-9813-3f65f8f80bba
			defaultHierarchy: LocalDateTable_3a243cba-dc59-490b-909d-8c55b52b6aa5.'Date Hierarchy'

		changedProperty = DataType

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

