	column '__$ Original First OnTimeDate' = ```
			
			IF (
			    RELATED('Measures (2)'[Use ]) = "First Date",
			    '0125'[Original First Date],
			    IF (
			        RELATED('Measures (2)'[Use ]) = "Planning End",
			        '0125'[Planning end],
			        IF (
			            RELATED('Measures (2)'[Use ]) = "Requested deliv.date",
			            '0125'[Requested deliv.date],
			            IF (
			                RELATED('Measures (2)'[Use ]) = "Planned date CheckIn",
			                '0125'[Planned date CheckIn],
			                IF (
			                    RELATED('Measures (2)'[Use ]) = "Guarantee Date",
			                    '0125'[Guarantee Date],
			                    '0125'[Original First Date]   // Default fallback
			                )
			            )
			        )
			    )
			)
			
