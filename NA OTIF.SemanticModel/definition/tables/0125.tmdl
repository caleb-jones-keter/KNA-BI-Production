	column _!ShippingType2 =
			
			IF(ISBLANK('0125'[_!ShippingType]),
			    IF('0125'[_Total TL Qty]> .5,
			        1,
			        IF(RELATED('ECOMM FILTER'[ECOMM/ Store])="Store",
			            6,
			            7
			        )
			    ),
			    IF(ISBLANK('0125'[Shipping type]),
			    VAR CurrentSO = '0125'[Sales Order]
			
			    VAR FilteredTable =
			        FILTER(
			            '0125',
			            '0125'[Sales Order] = CurrentSO &&
			            NOT(ISBLANK('0125'[Shipping type]))
			        )
			    RETURN
			        MAXX(FilteredTable, '0125'[Shipping type]),
			        '0125'[Shipping type]
