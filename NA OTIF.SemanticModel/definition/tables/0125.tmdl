	column _!OriginalFirstNotOnTime = ```
			
			VAR OnTimeFlag = RELATED('Delay Reasons'[On-time?])
			VAR ShipmentIssues =
			    '0125'[__$ Original First Shipped Early] +
			    [__$ Original First ShippedLate] +
			    '0125'[__$ Original First PastDueNotShipped]
			VAR UseFlag = RELATED('Measures (2)'[Use ])  -- same way you call MAX
			RETURN
			SWITCH(
			    TRUE(),
			    (UseFlag = "First Date" && '0125'[First Date] > '0125'[Original First Date]), 1,
			    OnTimeFlag = 1, 0,
			    ShipmentIssues > 0, 1,
			    0
			)
			
			
			
			```
		formatString: 0
		lineageTag: ec403b37-4386-4081-9ea3-dd49e5d11666
