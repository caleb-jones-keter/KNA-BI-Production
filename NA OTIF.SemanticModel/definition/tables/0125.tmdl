	column _!SkuCombined = CONVERT('0125'[Material],STRING) & " " & '0125'[Material description MM]
		lineageTag: 23c7840c-3f00-4158-bcc7-3492d83c5e82
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

	column _!Delivery =
			
			IF(ISBLANK('0125'[Delivery]),
			VAR CurrentSO = '0125'[Sales Order]
			
			VAR FilteredTable =
			    FILTER(
			        '0125',
			        '0125'[Sales Order] = CurrentSO &&
			        NOT(ISBLANK('0125'[Delivery]))
			    )
			VAR DelivNum = MAXX(FilteredTable, '0125'[Delivery])
			RETURN
			    IF(ISBLANK(DelivNum),'0125'[Sales Order],DelivNum),
			    '0125'[Delivery]
			)
		formatString: 0
		lineageTag: c45f2ba3-ae11-46c4-b0ef-c3437362cf1a
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column _!ShippingType =
			
			IF(ISBLANK('0125'[Shipping type]),
			VAR CurrentSO = '0125'[Sales Order]
			
			VAR FilteredTable =
			    FILTER(
			        '0125',
			        '0125'[Sales Order] = CurrentSO &&
			        NOT(ISBLANK('0125'[Shipping type]))
			    )
			RETURN
			    MAXX(FilteredTable, '0125'[Shipping type]),
			    '0125'[Shipping type]
			)
		formatString: 0
		lineageTag: cecf02f0-53d4-4766-8297-e1e18e2da0d1
		summarizeBy: sum

