	column '__$ Original First Reason' = ```
			
			IF(
			    '0125'[First Date] > '0125'[Original First Date],
			    "Late - Date Moved",
			    IF(
			        LEN([Reason for rejection]) > 0,
			        "Cut - " & RELATED(RfR[SAP Text]),
			        IF(
			            [__$ Original First ShippedLate] > 0,
			            IF(
			                LEN([Load Delay Reason]) > 0,
			                "Late - " & RELATED('Delay Reasons'[Delay Reason]),
			                IF(
			                    AND('0125'[Shipping type] = 7, '0125'[__$ Original First Variance] = 1),
			                    "Late - Parcel (1 Day)",
			                    IF(
			                        '0125'[Shipping type] = 7,
			                        "Late - Parcel (> 1 Day)",
			                        IF(
			                            '0125'[_!NeedsCode] = "Needs Code",
			                            "Late - Needs Code",
			                            "Late - Other"
			                        )
			                    )
			                )
			            ),
			            IF(
			                [__$ Original First Shipped Early] > 0,
			                "Early - Shipped Early",
			                IF(
			                    [__$ Original First PastDueNotShipped] > 0,
			                    IF(
			                        LEN([Load Delay Reason]) > 0,
			                        "Late - " & RELATED('Delay Reasons'[Delay Reason]),
			                        "Late - Past Due, Not Shipped"
			                    )
			                )
			            )
			        )
			    )
