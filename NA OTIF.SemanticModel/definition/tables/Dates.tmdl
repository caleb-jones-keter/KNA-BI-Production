		annotation SummarizationSetBy = Automatic

	partition Dates = calculated
		mode: import
		source = ```
				
				ADDCOLUMNS (
				    CALENDAR (DATE(2018, 1, 1), DATE(2030, 12, 31)),
				    "Year", YEAR([Date]),
				    "Month Number", MONTH([Date]),
				    "Month Name", FORMAT([Date], "MMMM"),
				    "Quarter", "Q" & FORMAT(QUARTER([Date]), "0"),
				    "Year-Month", FORMAT([Date], "YYYY-MM"),
				    "Weekday", FORMAT([Date], "dddd"),
				    "Weekday Number", WEEKDAY([Date], 2), // Monday = 1
				    "Is Weekend", IF(WEEKDAY([Date], 2) > 5, TRUE(), FALSE()),
				    "Year-Quarter", FORMAT([Date], "YYYY") & "-Q" & FORMAT(QUARTER([Date]), "0")
				)
				
				```

	annotation PBI_Id = 410b63375f144422b84390dd9fa61523

