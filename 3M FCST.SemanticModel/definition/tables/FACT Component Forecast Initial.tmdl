	measure '_ADS Days Annual' =
			
			VAR ReferenceDate = TODAY()
			VAR EndDate       = today()+365
			RETURN
			CALCULATE(
			    DISTINCTCOUNTNOBLANK('FACT Component Forecast Initial'[SOW]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    )
			)*7
		formatString: 0
		lineageTag: 25bea12d-0d67-42b5-9803-16b88c6f18f0

		changedProperty = Name

	measure '_FCST Offset' =
			
			VAR Days = (MAX('DIM Date'[Today])-MAX('DIM Date'[Today SOW]))/6
			RETURN
			CALCULATE(
			    SUM('FACT Future'[Combined Qty]),
			    'FACT Future'[Data Source] = "EDB APO",
			    'DIM Date'[SOW] =MAX('DIM Date'[Today SOW])
			)*Days*-1
		formatString: 0
		lineageTag: 392cee73-75a4-4a05-982b-77658031fac2

		changedProperty = Name

	measure '_FCST Offset Only First Week' =
			
			VAR Days = (MAX('DIM Date'[Today])-MAX('DIM Date'[Today SOW]))/6
			RETURN
			CALCULATE(
			    SUM('FACT Future'[Combined Qty]),
			    'FACT Future'[Data Source] = "EDB APO",
			    VALUES('DIM Date'[SOW]),
			    'DIM Date'[SOW] =MAX('DIM Date'[Today SOW])
			)*Days*-1
		lineageTag: d660f3f7-2c0c-4cf2-932e-e45d31a38c8f

