	measure '_ADS Numerator' = ```
			
			VAR ReferenceDate = MIN('DIM Date'[Full Date])
			VAR EndDate       = ReferenceDate + 140
			RETURN
			CALCULATE(
			    -SUM('FACT Component Forecast Initial'[Combined Qty]),
			    
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    )
			)
			```
		formatString: 0
		lineageTag: 27646289-651a-4cba-9774-d2cf7d7d8ef1

		changedProperty = Name

