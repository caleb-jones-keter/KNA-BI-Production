	measure '_$DI Order Status' = ```
			
			IF(
			    NOT(ISBLANK([_$DI LA Date MAGIC_Lookup])),
			    "Sailed",
			    IF(
			        [_$DI CONF CATEGORY MAGIC_Lookup] = "AB",
			        "Pending Keter",
			        IF(
			            AND(
			                NOT(ISBLANK([_$DI Container MAGIC_Lookup])),
			                [_$DI Container MAGIC_Lookup] <> ""
