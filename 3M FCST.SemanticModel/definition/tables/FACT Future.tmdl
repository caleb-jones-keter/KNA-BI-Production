	measure '_INV 3M FCST' =
			
			VAR ReferenceDate = MIN('DIM Date'[Today SOW])
			VAR EndDate       = MAX('DIM Date'[Full Date])
			RETURN
			CALCULATE(
			    SUM('FACT Future'[Combined Qty]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    )
			)
		formatString: 0
		lineageTag: f6ad2be9-fae5-444a-a92d-f6aec1989249

		changedProperty = Name

