	measure '_DOS Future' =
			IF([_INV + TRANS Future]>0,
			[_INV + TRANS Future]/([_ADS Numerator Future]/140))
		lineageTag: d3a7839a-8c32-4d3c-b40d-5b6c6ff59266

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_ADS Numerator Future' =
			
			VAR ReferenceDate = CALCULATE(
			            MIN('FACT Future'[Combined Date]),
			            'FACT Future'[Data Source]<>"YS10N"
			        )
			VAR EndDate = ReferenceDate + 140
			RETURN
			CALCULATE(
			    SUM('FACT Future'[Combined Qty]),
			    FILTER(
			        ALLSELECTED('FACT Future'),
			        'FACT Future'[Combined Date] >= ReferenceDate &&
			        'FACT Future'[Combined Date] <= EndDate &&
			        'FACT Future'[Data Source] = "EDB APO" &&
			        'FACT Future'[MRPSKU Key] in VALUES('FACT Future'[MRPSKU Key])
			    ))*-1
		formatString: 0
		lineageTag: 72cce839-2b3a-4b40-8863-6e94dbb31e98

		changedProperty = Name

		changedProperty = IsHidden

	measure '_DOS Future Size' =
