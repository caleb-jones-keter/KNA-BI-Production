	measure '_DOS Annual' =
			
			VAR EndDate =
			    today()+270
			
			VAR ForecastQty =
			    CALCULATE(
			        -SUM('FACT Component Forecast Initial'[Combined Qty]),
			        DATESBETWEEN('DIM Date'[Full Date], TODAY(), EndDate)
			    )
			RETURN
			IF(
			    ForecastQty > 0,
			
			SUM('FACT Future'[Combined Qty])/([_ADS Numerator Annual]/[_ADS Days Annual]),SUM('FACT Future'[Combined Qty])/0)
		lineageTag: 4ad7e0dc-24fb-42a0-9e6e-5cc5e2b90e24

