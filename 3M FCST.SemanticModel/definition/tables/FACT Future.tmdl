	measure '_Actual Days of Coverage 49 day Offset' =
			
			VAR ReferenceDate = Min('DIM Date'[SOW])
			VAR EndDate       = ReferenceDate + 365
			VAR FirstFutureDate =
			    CALCULATE(
			        MIN('FACT Future'[Combined Date]),
			        DATESBETWEEN(
			            'DIM Date'[Full Date],
			            ReferenceDate+49,
			            EndDate
			        ),
			        'FACT Future'[Inv] = 0,
			        'FACT Future'[Qty Not In Inv] <> 0
			    )
			VAR DaysCoverage =
			    FirstFutureDate - ReferenceDate
			RETURN
			IF(
			    [_ADS Numerator] > 0,
			    IF(
			        ISBLANK(FirstFutureDate),
			        365,                     -- Large number when no date found
			        MAX(DaysCoverage, 0)     -- Clamp negative values to 0
			    )
			)
		lineageTag: ce9a808b-3298-4bb1-ae7b-f3d870f169af

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Lost Sales DOC' =
			
			VAR ReferenceDate = MIN('DIM Date'[Full Date])
			VAR EndDate       = ReferenceDate + 140
			RETURN
			CALCULATE(
			    SUM('FACT Future'[Qty Not In Inv]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate+[_Actual Days of Coverage 49 day Offset],
			        EndDate
			    )
			)
