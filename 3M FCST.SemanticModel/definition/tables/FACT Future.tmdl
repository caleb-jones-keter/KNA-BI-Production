	measure '_Excess 26 Weeks' = ```
			
			VAR EndDate =
			    today()+365
			
			VAR ForecastQty =
			    CALCULATE(
			        -SUM('FACT Component Forecast Initial'[Combined Qty]),
			        DATESBETWEEN('DIM Date'[Full Date], TODAY(), EndDate)
			    )
			RETURN
			IF(
			    ForecastQty > 0,
			    
			    IF(
			        NOT(ISBLANK([_INV 26 Weeks])),
			        MAX(
			            0,
			            [_INV 26 Weeks] -
			                MAX('Max DOS'[Max DOS]) *
			                ([_ADS Numerator Annual] / [_ADS Days Annual])
			        )
			    ),[_INV 26 Weeks]
			)
			
			```
		lineageTag: 9a702136-c260-4b64-b693-ad927a8d47ef

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

