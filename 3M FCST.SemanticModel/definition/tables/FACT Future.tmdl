		changedProperty = IsHidden

	measure '_Actual Days of Coverage' =
			
			VAR ReferenceDate = Min('DIM Date'[SOW])
			VAR EndDate       = ReferenceDate + 365
			VAR FirstFutureDate =
			    CALCULATE(
			        MIN('FACT Future'[Combined Date]),
			        DATESBETWEEN(
			            'DIM Date'[Full Date],
			            ReferenceDate,
			            EndDate
			        ),
			        'FACT Future'[Inv] = 0,
			        'FACT Future'[Qty Not In Inv] <> 0
			    )
			VAR DaysCoverage =
			    FirstFutureDate - ReferenceDate
			RETURN
			IF(
			    [_ADS Numerator] > 0,
			    IF(
			        ISBLANK(FirstFutureDate),
			        365,                     -- Large number when no date found
			        MAX(DaysCoverage, 0)     -- Clamp negative values to 0
			    )
			)
		lineageTag: 528ece71-523b-42ee-9250-2827675701c9

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

