table 'DIM MRPSKU'
	lineageTag: 639009e4-8ac7-46fb-8951-95e40ee4063f
	sourceLineageTag: [dbo].[DIM MRPSKU]

	measure _Keep_MRPSKU = ```
			
			VAR col1 = MAXX(VALUES('FACT Future'[MRPSKU Key]), ABS([_MB52 Future]))
			VAR col2 = MAXX(VALUES('FACT Future'[MRPSKU Key]), ABS([_YM6P]))
			VAR col3 = MAXX(VALUES('FACT Future'[MRPSKU Key]), ABS([_YS10N]))
			VAR col4 = MAXX(VALUES('FACT Component Forecast Initial'[MRPSKU Key]), ABS([_Original Forecast]))
			RETURN
			IF(
			    (NOT ISBLANK(col1) && col1 > 0) ||
			    (NOT ISBLANK(col2) && col2 > 0) ||
			    (NOT ISBLANK(col3) && col3 > 0) ||
			    (NOT ISBLANK(col4) && col4 > 0),
			    1,
			    0
			)
			
			
			
			```
		formatString: 0
		lineageTag: 2cc4c057-2a3d-4710-8833-47306798b596

		changedProperty = Name

