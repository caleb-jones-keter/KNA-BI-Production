	column '_Height Ratio' = if('Item Sheet 2026'[_Stacked Plts]<=1,ROUNDDOWN(101.18/'Item Sheet 2026'[Current Item Sheet 2025 Specs.Pallet - Height],0),'Item Sheet 2026'[_Stacked Plts])
