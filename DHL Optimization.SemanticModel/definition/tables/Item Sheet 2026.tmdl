		lineageTag: 04a920ff-66fe-4775-9f9d-506bbc646b7f
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column '_Sqft Ratio' =
			
			IF('Item Sheet 2026'[_Actual Sqft]>0,ROUND('Item Sheet 2026'[_Initial Sqft/Plt]/'Item Sheet 2026'[_Actual Sqft],0),0)
		formatString: 0
		lineageTag: aa6be7e6-e085-48cc-88ae-50160c6311c4
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column '_Initial Plt Qty' =
			
			VAR pltQty =
			IF('Item Sheet 2026'[Current Item Sheet 2025 Specs.Pallet - Length]>89,
			    'Item Sheet 2026'[ContQty]/9,
			    IF('Item Sheet 2026'[_Height Ratio]>1,
			        IF('Item Sheet 2026'[_Stacked Plts]>0,
			            'Item Sheet 2026'[_Stacked Plts]*'Item Sheet 2026'[SS/PLTQty],
			            'Item Sheet 2026'[_Height Ratio]*'Item Sheet 2026'[SS/PLTQty]
			        ),
			        'Item Sheet 2026'[SS/PLTQty]
			    )
			)
			VAR sqftplt = 306.125/MAX(1,'Item Sheet 2026'[ContQty]/pltQty)
			RETURN
			pltQty
		lineageTag: 16920b53-3c36-4daa-8fbd-9443efa48142
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

