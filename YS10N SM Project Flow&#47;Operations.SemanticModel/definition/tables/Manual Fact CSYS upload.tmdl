table 'Manual Fact CSYS upload'
	isHidden
	lineageTag: 3551c717-425d-4ab5-b0ed-9f5e4e119f0a
	sourceLineageTag: [dbo].[Manual Fact CSYS upload]

	measure '_Container Qty' = ```
			
			SUMX(
			    VALUES('DIM Product'[Material]),
			    DIVIDE(
			        CALCULATE(SUM('Manual Fact CSYS upload'[Order Qty])),
			        CALCULATE(MAX('DIM Product'[Cont_Qty]))
			    )
			)
			
			```
		isHidden
		lineageTag: 2f672f65-e354-4b43-9ee4-55e5a4dba62e

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Truck Qty' = ```
			
			SUMX(
			    VALUES('DIM Product'[Material]),
			    DIVIDE(
			        CALCULATE(SUM('Manual Fact CSYS upload'[Order Qty])),
			        CALCULATE(MAX('DIM Product'[TL Qty]))
			    )
			)
			
			```
		isHidden
		lineageTag: 9faf99eb-c57d-4cc8-ae37-65a0f6703310

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

