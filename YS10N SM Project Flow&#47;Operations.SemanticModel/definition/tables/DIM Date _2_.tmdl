table 'DIM Date _2_'
	lineageTag: 93377252-8ab9-4e78-98be-a57d77a250fc
	sourceLineageTag: [dbo].[DIM Date _2_]

	measure _ShowWeekfilter2 = ```
			
			VAR CurrentWeek = WEEKNUM(TODAY(), 1)  -- Sunday start
			VAR WeekInContext = SELECTEDVALUE('DIM Date _2_'[Week of Year])
			RETURN
			IF(
			    WeekInContext <= CurrentWeek,
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: 275be167-6b45-4a75-b1fd-8eade32f699e

		changedProperty = Name

	measure _ShowYearfilter2 = ```
			
			VAR CurrentYear = YEAR(TODAY())
			VAR YearInContext =
			    SELECTEDVALUE('DIM Date _2_'[Year])  -- returns the year if only one is in context
			RETURN
			IF(
			    YearInContext = CurrentYear ||
			    YearInContext = CurrentYear - 1,
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: b09e5734-2191-4a38-a31f-27c4babeeb45

		changedProperty = Name

