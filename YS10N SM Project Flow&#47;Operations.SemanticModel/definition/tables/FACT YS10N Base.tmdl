table 'FACT YS10N Base'
	lineageTag: 90794529-93f1-4fd4-b268-1070cf21725d
	sourceLineageTag: [dbo].[FACT YS10N Base]

	measure _TL_Combined_Qty =
			
			SUMX(
			    'FACT YS10N Base',
			    VAR TLQty =
			        CALCULATE(
			            MAX('DIM Product'[TL Qty]),
			            FILTER(
			                'DIM Product',
			                'DIM Product'[Material] = 'FACT YS10N Base'[Material]
			            )
			        )
			    RETURN
			        IF(
			            ISBLANK(TLQty) || TLQty = 0,
			            BLANK(),  -- or 0 if you want to treat missing TLQty as zero
			            'FACT YS10N Base'[Combined Qty] / TLQty*-1
			        )
			)
		lineageTag: 983a9600-0264-470b-98e7-1ac241647188

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _Container_Combined_Qty =
			
			SUMX(
			    'FACT YS10N Base',
			    VAR CONTQty =
			        CALCULATE(
			            MAX('DIM Product'[Cont_Qty]),
			            FILTER(
			                'DIM Product',
			                'DIM Product'[Material] = 'FACT YS10N Base'[Material]
			            )
			        )
			    RETURN
			        IF(
			            ISBLANK(CONTQty) || CONTQty = 0,
			            BLANK(),  -- or 0 if you want to treat missing TLQty as zero
			            'FACT YS10N Base'[Combined Qty] / CONTQty*-1
			        )
			)
		lineageTag: 9c236976-6457-4c7a-be18-8707cba62b8a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Positive Qty' = ABS(SUM('FACT YS10N Base'[Combined Qty]))
		lineageTag: 83ea2b45-51ae-46b8-85ae-b24d44b7312d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _DistanceMiPerDelivery = ```
			
			IF(not(ISBLANK([_Positive Qty])),
			VAR OriginLat = calculate(MAX('DIM Storage Location'[Latitude]))
			VAR OriginLon = calculate(MAX('DIM Storage Location'[Longitude]))
			VAR DestLat   = calculate(MAX('DIM USA CA Zips'[LATITUDE]))
			VAR DestLon   = CALCULATE(MAX('DIM USA CA Zips'[LONGITUDE]))
			VAR RadiusMi  = 3959
			RETURN
			    ACOS(
			        SIN(RADIANS(OriginLat)) * SIN(RADIANS(DestLat)) +
			        COS(RADIANS(OriginLat)) * COS(RADIANS(DestLat)) *
			        COS(RADIANS(DestLon) - RADIANS(OriginLon))
			    ) * RadiusMi)
			
			```
		lineageTag: b3cacb83-fd46-4dab-9629-153b7339e25b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _AvgDistanceMiPerDelivery = ```
			
			VAR RadiusMi = 3959
			RETURN
			AVERAGEX(
			    FILTER(
			        'FACT YS10N Base', 
			        NOT(ISBLANK([_Positive Qty]))
			    ),
			    VAR OriginLat = CALCULATE(MAX('DIM Storage Location'[Latitude]))
			    VAR OriginLon = CALCULATE(MAX('DIM Storage Location'[Longitude]))
			    VAR DestLat   = CALCULATE(MAX('DIM USA CA Zips'[LATITUDE]))
			    VAR DestLon   = CALCULATE(MAX('DIM USA CA Zips'[LONGITUDE]))
			    RETURN
			        ACOS(
			            SIN(RADIANS(OriginLat)) * SIN(RADIANS(DestLat)) +
			            COS(RADIANS(OriginLat)) * COS(RADIANS(DestLat)) *
			            COS(RADIANS(DestLon) - RADIANS(OriginLon))
			        ) * RadiusMi
			)
			
			```
		lineageTag: 0c9d0803-56fd-4206-a292-49955ab9deaa

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Distance Cost' = ```
			max(0,[_DistanceMiPerDelivery]-300)*.5
			
			
			
			
			```
		lineageTag: 2a69416f-745c-413c-91ed-e662082a1438

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total Distance Cost' = SUMx('FACT YS10N Base',[_Distance Cost])
		lineageTag: 4bcb8085-08ff-43fa-a6ee-4946cf15400a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _weekofyearcutvalue = ```
			
			CALCULATE(
			    SUMX('FACT YS10N Base', 'FACT YS10N Base'[Net Value USD]),
			    FILTER(
			        'DIM Date _2_',
			        'DIM Date _2_'[Week of Year] <= WEEKNUM(TODAY(), 1)
			       
			    )
			)
			
			
			
			```
		lineageTag: 3fb9e381-5e1a-45fd-8542-913bb9996c9b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _weekofyearsalesvalue = ```
			
			VAR CurrentWeek = WEEKNUM(TODAY(), 1)
			
			RETURN
			CALCULATE(
			    SUM('FACT YS10N Base'[Net Value USD]),
			    FILTER(
			        'DIM Date',
			        'DIM Date'[Week of Year] <= CurrentWeek 
			    )
			)
			
			```
		lineageTag: 4cce6b66-be17-452a-8c7b-b4ee488fe2be

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _MinDistance = ```
			
			MINX (
			    'DIM USA CA Zips',
			    VAR d1 = 'DIM USA CA Zips'[Distance from DHL]
			    VAR d2 = 'DIM USA CA Zips'[Distance from Rancho]
			    VAR d3 = 'DIM USA CA Zips'[Distance from SpreeTail Nanticoke]
			    VAR d4 = 'DIM USA CA Zips'[Distance from SpreeTail Vegas]
			    VAR m12 = MIN ( d1, d2 )
			    VAR m34 = MIN ( d3, d4 )
			    RETURN
			        MIN ( m12, m34 )
			)
			
			```
		formatString: 0
		lineageTag: 5832c2c4-48c8-4627-8672-2ce47bcdbbe4

		changedProperty = Name

	measure _BestLocation = ```
			
			VAR dhl =
			    MIN ( 'DIM USA CA Zips'[Distance from DHL] )
			VAR rancho =
			    MIN ( 'DIM USA CA Zips'[Distance from Rancho] )
			VAR nanticoke =
			    MIN ( 'DIM USA CA Zips'[Distance from SpreeTail Nanticoke] )
			VAR vegas =
			    MIN ( 'DIM USA CA Zips'[Distance from SpreeTail Vegas] )
			
			VAR CandidatesRaw =
			    UNION (
			        ROW ( "Loc", "DHL",                 "Dist", dhl,      "Rank", 1 ),
			        ROW ( "Loc", "Rancho",              "Dist", rancho,   "Rank", 2 ),
			        ROW ( "Loc", "Spreetail Nanticoke", "Dist", nanticoke,"Rank", 3 ),
			        ROW ( "Loc", "Spreetail Vegas",     "Dist", vegas,    "Rank", 4 )
			    )
			
			VAR Candidates =
			    FILTER ( CandidatesRaw, NOT ISBLANK ( [Dist] ) )
			
			VAR MinDist =
			    MINX ( Candidates, [Dist] )
			
			VAR Winner =
			    TOPN (
			        1,
			        FILTER ( Candidates, [Dist] = MinDist ),
			        [Rank], ASC
			    )
			RETURN
			    MAXX ( Winner, [Loc] )
			
			```
		lineageTag: f6dda15c-f6e3-4585-b2bc-773312dca76e

		changedProperty = Name

