	measure '_$lineOrder Pallets' = ```
			
			SUMX(
			    'FACT YS10N Base',
			    DIVIDE(
			        'FACT YS10N Base'[Combined Qty],
			        RELATED('DIM Product'[SS/PLT_Qty])
			    )
			)
			
			```
		lineageTag: 723d1dda-0f81-467e-9e29-1608f08dc430

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$Order Has Any SKU' = ```
			
			VAR SKUsWith3PlusPallets =
			    COUNTROWS(
			        FILTER(
			            VALUES('DIM Product'[SKU & Desc]),
			            DIVIDE(
			                CALCULATE(SUM('FACT YS10N Base'[Combined Qty])),
			                MAX('DIM Product'[SS/PLT_Qty])
			            ) <= -3
			        )
			    )
			RETURN
			    IF(SKUsWith3PlusPallets > 0, 1)
			
			```
		formatString: 0
		lineageTag: 26de284b-c3f5-4502-a948-724864170205

		changedProperty = Name

	measure '_$Order Count over3shipment' = ```
			
			VAR ShipmentSKUCheck =
			    SUMMARIZE(
			        'FACT YS10N Base',
			        'FACT YS10N Base'[Shipment Number],
			        'DIM Product'[SKU & Desc],
			        "Pallets",
			            DIVIDE(
			                SUM('FACT YS10N Base'[Combined Qty]),
			                MAX('DIM Product'[SS/PLT_Qty])
			            )
			    )
			RETURN
			    COALESCE(
			        COUNTROWS(
			            FILTER(
			                ShipmentSKUCheck,
			                [Pallets] <= -3
			            )
			        ),
			        0
			    )
			
			
			```
		formatString: 0
		lineageTag: 61e35efd-4602-4ffa-a184-5d3807922750

		changedProperty = Name

	measure '_$ Distinct Shipments with SKU 3+plt' =
			
			COUNTROWS(
			    FILTER(
			        DISTINCT('FACT YS10N Base'[Shipment Number]),
			        [_$Order Count over3shipment] > 0
			    )
			)
		formatString: 0
		lineageTag: 9792da7b-34be-4993-ba03-006bae50c89e

		changedProperty = Name

	measure '_CombinedQty_per_TLQty Group' =
			
			CALCULATE(
			    SUM('FACT YS10N Base'[CombinedQty_per_TLQty]),
			    ALLEXCEPT(
			        'FACT YS10N Base',
			        'FACT YS10N Base'[MRPSKU Key],
			        'FACT YS10N Base'[Payer],
			        'FACT YS10N Base'[ShipToZip_Clean]
			    )
			)
		lineageTag: 503216c4-24ae-473d-9677-c6dd8f2e4a65

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

