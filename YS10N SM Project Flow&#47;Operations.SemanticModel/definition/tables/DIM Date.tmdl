table 'DIM Date'
	lineageTag: ce0303b5-b777-4e46-8027-ad745a23d997
	sourceLineageTag: [dbo].[DIM Date]

	measure _ShowYearfilter = ```
			
			VAR CurrentYear = YEAR(TODAY())
			VAR YearInContext =
			    SELECTEDVALUE('DIM Date'[Year])  -- returns the year if only one is in context
			RETURN
			IF(
			    YearInContext = CurrentYear ||
			    YearInContext = CurrentYear - 1,
			    1,
			    0
			)
			
			
			```
		formatString: 0
		lineageTag: 1485f022-3da3-4280-9edb-14433190f6df

		changedProperty = Name

	measure _ShowWeekfilter = ```
			
			VAR CurrentWeek = WEEKNUM(TODAY(), 1)  -- Sunday start
			VAR WeekInContext = SELECTEDVALUE('DIM Date'[Week of Year])
			RETURN
			IF(
			    WeekInContext <= CurrentWeek,
			    1,
			    0
			)
			
			```
		formatString: 0
		lineageTag: 6e1b4c98-7533-4f26-b8be-f78fe423d3a4

		changedProperty = Name

