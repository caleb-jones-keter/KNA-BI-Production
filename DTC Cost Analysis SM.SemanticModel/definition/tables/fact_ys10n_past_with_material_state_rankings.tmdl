table fact_ys10n_past_with_material_state_rankings
	lineageTag: 99c674f5-c145-4b48-bf3e-8e7569cb1f5a
	sourceLineageTag: [dbo].[fact_ys10n_past_with_material_state_rankings]

	measure '_Min State Rank' =
			
			CALCULATE(
			    MIN(fact_ys10n_past_with_material_state_rankings[state_total_cost_rn]),
			    REMOVEFILTERS('DIM DTC Ship Point Key'),
			    ALLSELECTED('DIM DTC Ship Point Key'[shipping_point_key_desc])
			)
		formatString: 0
		lineageTag: f459b0e8-3169-4364-a9c6-80dd75d9f8c2

		changedProperty = Name

	measure '_Is Best State Ship Point' = IF(NOT(ISBLANK(MIN(fact_ys10n_past_with_material_state_rankings[state_total_cost_rn]))),IF(MIN(fact_ys10n_past_with_material_state_rankings[state_total_cost_rn])=[_Min State Rank],1))
		formatString: 0
		lineageTag: e474c0f2-985f-4c91-991a-7df99f261dce

		changedProperty = Name

	measure '_State Deliveries' =
			
			SUMX(Values(fact_ys10n_past_with_material_state_rankings[Delivery]),[_Is Best State Ship Point])
		formatString: 0
		lineageTag: b8c490c5-3d57-44c9-b444-0e81d4f3ea06

		changedProperty = Name

	measure '_Loaded Cost State' =
			
			// SUMX(
			//     SUMMARIZE(
			//         fact_ys10n_past_with_material_state_rankings,
			//         'DIM Product'[Material],
			//         'DIM USA CA Zips'[POSTAL_CODE]
			//     ),
			//     CALCULATE(
			//         DISTINCTCOUNT(fact_ys10n_past_with_material_state_rankings[Delivery])
			//             * MIN(fact_ys10n_past_with_material_state_rankings[weighted_avg_total_cost]
			//     )
			// ))
			SUMX(
			    fact_ys10n_past_with_material_state_rankings,
			    -fact_ys10n_past_with_material_state_rankings[combined_qty]
			        * fact_ys10n_past_with_material_state_rankings[weighted_avg_total_cost]
			)
		lineageTag: 105f3545-cb5c-4fde-a0f8-6d99e272aa19

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Min Weighted Avg Total Cost' =
			
			MINX(
			    SUMMARIZE(
			        fact_ys10n_past_with_material_state_rankings,
			        'DIM Product'[SKU & Desc],
			        'DIM USA CA Zips'[Postal Code Clean],
			        'DIM Customer'[Payer & Desc],
			        'DIM USA CA Zips'[REGION]
			    ),
			    CALCULATE(
			        MIN(fact_forecast_with_material_state_rankings[weighted_avg_total_cost])
			    )
			)
		lineageTag: 7e1d1abc-1310-4a84-961e-2c405fe3d3d0

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure Measure
		lineageTag: 92486011-42f4-4eaa-99ae-6d5a59732a0e

		annotation 43dbc3e8-3a1c-4b6f-9923-b49ff7d6691c = True

	measure '_Loaded Cost State No Storage' =
			
			// SUMX(
			//     SUMMARIZE(
			//         fact_ys10n_past_with_material_state_rankings,
			//         'DIM Product'[Material],
			//         'DIM USA CA Zips'[POSTAL_CODE]
			//     ),
			//     CALCULATE(
			//         DISTINCTCOUNT(fact_ys10n_past_with_material_state_rankings[Delivery])
			//             * MIN(fact_ys10n_past_with_material_state_rankings[weighted_avg_total_cost]
			//     )
			// ))
			SUMX(
			    fact_ys10n_past_with_material_state_rankings,
			    -fact_ys10n_past_with_material_state_rankings[combined_qty]
			        * fact_ys10n_past_with_material_state_rankings[weighted_avg_total_cost_no_storage]
			)
		lineageTag: 6ce9097e-2c07-421c-9403-85fb09b6bcfb

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qty State' = -SUM(fact_ys10n_past_with_material_state_rankings[combined_qty])
		lineageTag: e6ed0b51-6680-4125-ae94-0989b283c126

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Loaded Cost State (old)' =
			
			SUMX(
			    SUMMARIZE(
			        fact_ys10n_past_with_material_state_rankings,
			        'DIM Product'[Material],
			        'DIM USA CA Zips'[POSTAL_CODE]
			    ),
			    CALCULATE(
			        DISTINCTCOUNT(fact_ys10n_past_with_material_state_rankings[Delivery])
			            * MIN(fact_ys10n_past_with_material_state_rankings[weighted_avg_total_cost]
			    )
			))
		lineageTag: cdc581f6-c74e-4ee0-a768-eb2c80525e37

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

