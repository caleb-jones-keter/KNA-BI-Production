table fact_dummy_ys10n_top_12
	lineageTag: d5aeb095-c6c6-4f93-99b3-83b1fb00e5f7
	sourceLineageTag: [dbo].[fact_dummy_ys10n_top_12]

	measure '_Loaded Cost' =
			
			// SUMX(
			//     SUMMARIZE(
			//         fact_dummy_ys10n_top_12,
			//         'DIM Product'[Material],
			//         'DIM USA CA Zips'[POSTAL_CODE]
			//     ),
			//     CALCULATE(
			//         DISTINCTCOUNT(fact_dummy_ys10n_top_12[Delivery])
			//             * MIN(fact_dummy_ys10n_top_12[ranked_total_cost])
			//     )
			// )
			SUMX(
			    fact_dummy_ys10n_top_12,
			    -fact_dummy_ys10n_top_12[combined_qty]
			        * fact_dummy_ys10n_top_12[ranked_total_cost]
			)
		lineageTag: 8ddc42c6-710e-4977-b5e8-97748ec46423

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Is Best Zip Ship Point' = IF(NOT(ISBLANK(MIN(fact_dummy_ys10n_top_12[cost_ranking]))),IF(MIN(fact_dummy_ys10n_top_12[cost_ranking])=[_Min Zip Rank],1))
		formatString: 0
		lineageTag: 70380f0c-fc0c-468f-9f8a-11da40e6f727

		changedProperty = Name

	measure '_Min Zip Rank' =
			
			CALCULATE(
			    MIN(fact_dummy_ys10n_top_12[cost_ranking]),
			    REMOVEFILTERS('DIM DTC Ship Point Key'),
			    ALLSELECTED('DIM DTC Ship Point Key'[shipping_point_key_desc])
			)
		formatString: 0
		lineageTag: c4f33be6-d7f2-4c85-8090-786e30033926

		changedProperty = Name

	measure '_Other Min' =
			MINX(
			    VALUES(fact_dummy_ys10n_top_12[Delivery]),MIN(fact_dummy_ys10n_top_12[cost_ranking]))
		formatString: 0
		lineageTag: f373ddc2-c651-424e-a063-e74a7329f204

		changedProperty = Name

	measure '_One Last Thing That Won''t Work' = SUMX(Values(fact_dummy_ys10n_top_12[Delivery]),[_Is Best Zip Ship Point])
		formatString: 0
		lineageTag: 52fb2951-fc04-4796-908e-10dc16dd3b26

		changedProperty = Name

	measure '_Loaded Cost Actual' =
			
			// SUMX(
			//     SUMMARIZE(
			//         fact_dummy_ys10n_top_12,
			//         'DIM Product'[Material],
			//         'DIM USA CA Zips'[POSTAL_CODE]
			//     ),
			//     CALCULATE(
			//         DISTINCTCOUNT(fact_dummy_ys10n_top_12[Delivery])
			//             * (MIN(fact_dummy_ys10n_top_12[actual_total_cost])-MIN(fact_dummy_ys10n_top_12[actual_YR51_ea_cost]))
			//     )
			// )
			
			SUMX(
			    fact_dummy_ys10n_top_12,
			    -fact_dummy_ys10n_top_12[combined_qty]
			        * fact_dummy_ys10n_top_12[actual_total_cost]
			)
		lineageTag: 1c1dd50a-bfe3-4bfc-8400-63325a660a1e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Caleb''s Stupid Filter that Might Work' = ```
			IF(NOT(ISBLANK(MIN(fact_dummy_ys10n_top_12[cost_ranking_no_storage]))),IF(MIN(fact_dummy_ys10n_top_12[cost_ranking_no_storage])=[_Min Zip Rank No Storage],1))
			
			```
		formatString: 0
		lineageTag: de5a7ac4-dd29-4d29-a848-579ca5d4212f

		changedProperty = Name

	measure '_Min Zip Rank No Storage' =
			CALCULATE(
			    MIN(fact_dummy_ys10n_top_12[cost_ranking_no_storage]),
			    REMOVEFILTERS('DIM DTC Ship Point Key'),
			    ALLSELECTED('DIM DTC Ship Point Key'[shipping_point_key_desc]))
		formatString: 0
		lineageTag: 6a377558-e7bc-4261-8023-afdace18823f

		changedProperty = Name

	measure '_One Last Thing That WILL Work' = SUMX(VALUES(fact_dummy_ys10n_top_12[Delivery]),[_Caleb's Stupid Filter that Might Work])
		formatString: 0
		lineageTag: 7e1c8fa1-60fc-46c8-aa32-df8619125f3f

		changedProperty = Name

	measure '_Loaded Cost No Storage' =
			
			SUMX(
			    SUMMARIZE(
			        fact_dummy_ys10n_top_12,
			        'DIM Product'[Material],
			        'DIM USA CA Zips'[POSTAL_CODE]
			    ),
			    CALCULATE(
			        DISTINCTCOUNT(fact_dummy_ys10n_top_12[Delivery])
			            * MIN(fact_dummy_ys10n_top_12[ranked_total_cost_no_storage])
			    )
			)
		lineageTag: d10428bf-3411-4820-bb2b-376b302afb99

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _NetFullfill =
			
			IF(
			    NOT(ISBLANK(MIN(fact_dummy_ys10n_top_12[cost_ranking]))),
			    IF(MIN(fact_dummy_ys10n_top_12[cost_ranking])=[_Min Zip Rank],
			        MIN(fact_dummy_ys10n_top_12[ranked_net_fulfillment_cost])
			    )
			)
		lineageTag: db3b48e9-689c-44eb-818f-3593735450aa

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total NetFulfill' = SUMX(Values(fact_dummy_ys10n_top_12[Delivery]),[_NetFullfill])
		lineageTag: 0ff4e438-b9ef-4a6f-bc7a-7d5e6035e0ed

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Avg NetFulfill' = AVERAGEX(Values(fact_dummy_ys10n_top_12[Delivery]),[_NetFullfill])
		lineageTag: 15b5de94-6533-46bb-b4d3-d675f672e026

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_One Last Thing That Won''t Work 2' = SUMX(Values(fact_dummy_ys10n_top_12[Delivery]),fact_ys10n_past_with_material_state_rankings[_Is Best State Ship Point])
		formatString: 0
		lineageTag: f4585fe8-ef96-409b-bd2d-2493132585f4

		changedProperty = Name

	measure Qty = -SUM(fact_dummy_ys10n_top_12[combined_qty])
		lineageTag: 03bbf4e9-27f9-447a-ae04-03331e556ba2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Loaded Cost Actual No Storage' =
			
			// SUMX(
			//     SUMMARIZE(
			//         fact_dummy_ys10n_top_12,
			//         'DIM Product'[Material],
			//         'DIM USA CA Zips'[POSTAL_CODE]
			//     ),
			//     CALCULATE(
			//         DISTINCTCOUNT(fact_dummy_ys10n_top_12[Delivery])
			//             * (MIN(fact_dummy_ys10n_top_12[actual_total_cost])-MIN(fact_dummy_ys10n_top_12[actual_YR51_ea_cost]))
			//     )
			// )
			
			SUMX(
			    fact_dummy_ys10n_top_12,
			    -fact_dummy_ys10n_top_12[combined_qty]
			        * fact_dummy_ys10n_top_12[actual_total_cost_no_storage]
			)
		lineageTag: 9a6dffd7-6a26-47dc-adb5-5ad370001f74

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

