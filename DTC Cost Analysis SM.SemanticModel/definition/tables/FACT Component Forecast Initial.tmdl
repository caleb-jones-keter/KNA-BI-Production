table 'FACT Component Forecast Initial'
	lineageTag: fa269290-ed4c-49ff-93db-8aecb895203c
	sourceLineageTag: [dbo].[FACT Component Forecast Initial]

	measure '_ADS Numerator' = ```
			
			VAR ReferenceDate = MIN('FACT Component Forecast Initial'[Today SOW])
			VAR EndDate       = ReferenceDate + 139
			RETURN
			CALCULATE(
			    -SUM('FACT Component Forecast Initial'[Combined Qty]),
			    
			    DATESBETWEEN(
			        'FACT Component Forecast Initial'[SOW],
			        ReferenceDate,
			        EndDate
			    )
			)
			```
		formatString: 0
		lineageTag: 0b3e1a2b-7110-4a62-9fca-a7da7a06a693

		changedProperty = Name

		changedProperty = IsHidden

	measure '_ADS Denominator' = ```
			
			VAR ReferenceDate = MIN('FACT Component Forecast Initial'[Today SOW])
			VAR EndDate       = ReferenceDate + 140
			RETURN  
			    DATEDIFF(ReferenceDate, EndDate, DAY) + 1
			```
		formatString: 0
		lineageTag: 2c784275-6e19-4eb9-af31-f8d0b42edc7b

		changedProperty = Name

		changedProperty = IsHidden

	measure _ADS =
			
			VAR ReferenceDate =
			    MIN('FACT Component Forecast Initial'[Today SOW])
			
			VAR EndDate =
			    ReferenceDate + 140
			
			RETURN
			DIVIDE(
			    CALCULATE(
			        -SUM('FACT Component Forecast Initial'[Combined Qty]),
			        DATESBETWEEN(
			            'FACT Component Forecast Initial'[SOW],
			            ReferenceDate,
			            EndDate
			        )
			    ),
			    DATEDIFF(ReferenceDate, EndDate, DAY) + 1
			)
		lineageTag: 67dec909-8926-49fe-93df-cb1de6c25bcf

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_DOS (Material Avg)' =
			
			AVERAGEX(
			    VALUES('DIM Product'[Material]),
			    DIVIDE(
			        MAX('DIM Product'[TL Qty]) /4,
			        DIVIDE([_ADS Numerator],140)
			    )
			)
		lineageTag: d7afb902-771e-4b3c-992a-c79e82c4ba32

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Avg Inventory' = MAX('DIM Product'[TL Qty]) / 4
		lineageTag: c1424a27-d2c4-4ce0-84d5-38079375bdc8

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_DOS (Weighted)' =
			
			DIVIDE(
			    SUMX('DIM Product', MAX('DIM Product'[TL Qty])/ 4),
			    [_ADS Numerator] / 140
			)
		lineageTag: fded52b5-18e9-4edf-b05a-135bafc36801

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_ADS tom' = [_ADS Numerator]/140
		lineageTag: 529981ba-5d81-4dfe-bfa4-4e0a37205940

		changedProperty = Name

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_FC Sales Units' =
			
			VAR _fc =
			    CALCULATE(
			        -DIVIDE(
			            SUM('FACT Component Forecast Initial'[Combined Qty]),
			            5
			        ),
			        FILTER(
			            'FACT Component Forecast Initial',
			            'FACT Component Forecast Initial'[SOW] >= 'FACT Component Forecast Initial'[Today SOW]
			                && 'FACT Component Forecast Initial'[SOW] <= 'FACT Component Forecast Initial'[Today SOW] + 139
			        )
			    )
			RETURN
			    _fc
		lineageTag: 68cb3262-4d40-4f7f-90ba-d63506d3027b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Avg FC Sales Units' =
			
			CALCULATE(
			    AVERAGEX(ALL('DIM Product'), [_FC Sales Units])
			)
		lineageTag: 5197e7c6-5b5c-4c7d-89a5-92444512b378

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_FC Sales Units Used' =
			
			COALESCE(
			    [_FC Sales Units],
			    [_Avg FC Sales Units]
			)
		lineageTag: be97632c-6987-4ffd-9c6a-c52609342aa3

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total Storage Cost' =
			
			SUMX(
			    VALUES('DIM Product'[Material]),
			    VAR _half_container_units =
			        DIVIDE(MAX('DIM Product'[Cont_Qty]), 2.0)
			
			    VAR _carton_volume_ft3 =
			        MAX('DIM Product'[Specs.Carton - Volume])
			
			    VAR _fc_sales_units =
			        [_FC Sales Units Used]
			
			    VAR _fc_ads =
			        DIVIDE(_fc_sales_units, 140.0)
			
			    VAR _half_container_dos =
			        DIVIDE(_half_container_units, _fc_ads)
			
			    VAR _daily_rate_61_120 =
			        DIVIDE(0.60, 30.4167) * _carton_volume_ft3
			
			    VAR _daily_rate_121_plus =
			        DIVIDE(1.20, 30.4167) * _carton_volume_ft3
			
			    VAR _units_start_61_120 =
			        MAX(_half_container_units - (_fc_ads * 60.0), 0)
			
			    VAR _units_start_121_plus =
			        MAX(_half_container_units - (_fc_ads * 120.0), 0)
			
			    VAR _days_61_120 =
			        MIN(MAX(_half_container_dos - 60.0, 0), 60.0)
			
			    VAR _days_121_plus =
			        MAX(_half_container_dos - 120.0, 0)
			
			    VAR _units_end_61_120 =
			        MAX(_units_start_61_120 - (_fc_ads * _days_61_120), 0)
			
			    VAR _units_end_121_plus =
			        MAX(_units_start_121_plus - (_fc_ads * _days_121_plus), 0)
			
			    VAR _cost_61_120 =
			        _days_61_120
			            * DIVIDE(_units_start_61_120 + _units_end_61_120, 2.0)
			            * _daily_rate_61_120
			
			    VAR _cost_121_plus =
			        _days_121_plus
			            * DIVIDE(_units_start_121_plus + _units_end_121_plus, 2.0)
			            * _daily_rate_121_plus
			
			    RETURN
			        _cost_61_120 + _cost_121_plus
			)
		lineageTag: ef257b5a-28c5-4ed5-8451-41fcd4e4a1cc

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total Storage Cost Per Unit' =
			
			DIVIDE(
			    [_Total Storage Cost],
			    SUMX(
			        VALUES('DIM Product'[Material]),
			        DIVIDE(MAX('DIM Product'[Cont_Qty]), 2.0)
			    )
			)
		lineageTag: e0eaef95-3855-43be-b1d8-a3834de3253b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _spreetail_count = ```
			
			    CALCULATE(
			        COUNTROWS(VALUES('fact_dummy_ys10n_top_12'[ranked_shipping_point_key_desc])),
			        FILTER(
			            VALUES('fact_dummy_ys10n_top_12'[ranked_shipping_point_key_desc]),
			            CONTAINSSTRING('fact_dummy_ys10n_top_12'[ranked_shipping_point_key_desc], "Spreetail")
			        )
			    )
			
			```
		formatString: 0
		lineageTag: 94909c55-fe5f-4275-a195-15a84423d67a

		changedProperty = Name

