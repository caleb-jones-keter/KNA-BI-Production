table fact_forecast_with_material_state_rankings
	lineageTag: 40cfc817-46c8-433c-9195-ffca2c29ad7e
	sourceLineageTag: [dbo].[fact_forecast_with_material_state_rankings]

	measure '_Min State Rank Forecast' =
			
			CALCULATE(
			    MIN(fact_forecast_with_material_state_rankings[state_total_cost_rn]),
			    REMOVEFILTERS('DIM DTC Ship Point Key'),
			    ALLSELECTED('DIM DTC Ship Point Key'[shipping_point_key_desc])
			)
		formatString: 0
		lineageTag: ac40a667-35fd-430c-abff-04acaea914e5

		changedProperty = Name

	measure '_Is Best State Ship Point Forecast' =
			IF(
			    NOT(
			        ISBLANK(
			            MIN(fact_forecast_with_material_state_rankings[state_total_cost_rn])
			        )
			    ),
			    IF(MIN(fact_forecast_with_material_state_rankings[state_total_cost_rn])=[_Min State Rank Forecast],1)
			)
		formatString: 0
		lineageTag: 78633aa5-c93b-4ba3-8808-371afb317fbd

		changedProperty = Name

	measure '_FC Qty' =
			
			SUMX(
			    VALUES('DIM DTC Ship Point Key'[shipping_point_key_desc]),
			    CALCULATE(
			        SUMX(
			            FILTER(
			                fact_forecast_with_material_state_rankings,
			                [_Is Best State Ship Point Forecast] = 1
			            ),
			            fact_forecast_with_material_state_rankings[state_fc_qty]
			        )
			    )
			)
		lineageTag: a5425df4-d854-43a5-b804-00cb4398ee2a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Loaded Cost Forecast' =
			
			SUMX(
			    fact_forecast_with_material_state_rankings,
			    fact_forecast_with_material_state_rankings[state_fc_qty]
			        * fact_forecast_with_material_state_rankings[weighted_avg_total_cost]
			)
		lineageTag: a5ae41b8-def6-49ec-b4dd-f3639a58ae95

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

