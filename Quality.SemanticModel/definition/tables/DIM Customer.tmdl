table 'DIM Customer'
	lineageTag: 3a5208b7-d275-4157-8e4f-31cac24a280f
	sourceLineageTag: [dbo].[DIM Customer]

	measure 'Rejections Customer Filter' = IF([RTV (M)]>0,"Has Rejections")
		lineageTag: a85fb28f-9103-4cc5-a20e-7b7203fd281e

		changedProperty = Name

	measure 'Defective Allowance' =
			
			VAR Cust = MAX('DIM Customer'[Customer Groups])
			RETURN
			IF(Cust="AMAZON","Has Defect Allowance",
			IF(Cust="WAYFAIR","Has Defect Allowance",
			IF(Cust="CANADIAN TIRE","Has Defect Allowance",
			IF(Cust="STAPLES","Has Defect Allowance",
			IF(Cust="VM INNOVATIONS","Has Defect Allowance")))))
		lineageTag: 676f564c-3bdc-48d0-a79f-26198d047f7f

		changedProperty = Name

	measure 'Estimated Baseline Customer Group' =
			
			VAR Known =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( 'DIM Customer'[Customer Groups] ),
			            "X", CALCULATE ( [TL %] ),
			            "Y", CALCULATE ( [RTV %] )
			        ),
			        NOT ( ISBLANK ( [X] ) )
			            && NOT ( ISBLANK ( [Y] ) )
			    )
			
			VAR Count_Items =
			    COUNTROWS ( Known )
			
			VAR Sum_X =
			    SUMX ( Known, [X] )
			
			VAR Sum_X2 =
			    SUMX ( Known, [X] * [X] )
			
			VAR Sum_Y =
			    SUMX ( Known, [Y] )
			
			VAR Sum_XY =
			    SUMX ( Known, [X] * [Y] )
			
			VAR Average_X =
			    DIVIDE ( Sum_X, Count_Items )
			
			VAR Average_Y =
			    DIVIDE ( Sum_Y, Count_Items )
			
			VAR Slope =
			    DIVIDE (
			        Count_Items * Sum_XY - Sum_X * Sum_Y,
			        Count_Items * Sum_X2 - Sum_X * Sum_X
			    )
			
			VAR Intercept =
			    Average_Y - Slope * Average_X
			
			RETURN
			    Intercept + Slope
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a9e08269-11c6-4407-8032-102d7af69c8e

		changedProperty = Name

		changedProperty = FormatString

