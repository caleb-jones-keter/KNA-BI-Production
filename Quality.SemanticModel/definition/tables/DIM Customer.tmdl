			        Count_Items * Sum_X2 - Sum_X * Sum_X
			    )
			
			VAR Intercept =
			    Average_Y - Slope * Average_X
			
			RETURN
			    Intercept
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 63a5bde3-f4b8-433a-b403-e003d2b69b36

		changedProperty = Name

		changedProperty = FormatString

	measure 'Estimated Slope Customer Group' =
			
			VAR Known =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( 'DIM Customer'[Customer Groups] ),
			            "X", CALCULATE ( [TL %] ),
			            "Y", CALCULATE ( [RTV %] )
			        ),
			        NOT ( ISBLANK ( [X] ) )
			            && NOT ( ISBLANK ( [Y] ) )
			    )
			
			VAR Count_Items =
			    COUNTROWS ( Known )
			
			VAR Sum_X =
			    SUMX ( Known, [X] )
			
			VAR Sum_X2 =
			    SUMX ( Known, [X] * [X] )
			
			VAR Sum_Y =
			    SUMX ( Known, [Y] )
			
			VAR Sum_XY =
			    SUMX ( Known, [X] * [Y] )
			
			VAR Average_X =
			    DIVIDE ( Sum_X, Count_Items )
			
			VAR Average_Y =
			    DIVIDE ( Sum_Y, Count_Items )
			
			VAR Slope =
			    DIVIDE (
			        Count_Items * Sum_XY - Sum_X * Sum_Y,
			        Count_Items * Sum_X2 - Sum_X * Sum_X
			    )
			
			VAR Intercept =
			    Average_Y - Slope * Average_X
			
			RETURN
			    Slope
		formatString: 0.000
		lineageTag: b560d522-7877-4468-8422-2e10ba66272a

		changedProperty = Name

		changedProperty = FormatString

	measure 'R² RTV % vs TL % Customer Group' = ```
			
			VAR CorrTable =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( 'DIM Customer'[Customer Groups] ),
			            "X", CALCULATE ( [TL %] ),
			            "Y", CALCULATE ( [RTV %] )
			        ),
			        NOT ISBLANK ( [X] ) && NOT ISBLANK ( [Y] )
			    )
			
			VAR N =
			    COUNTROWS ( CorrTable )
			
			VAR SX =
			    SUMX ( CorrTable, [X] )
			
			VAR SY =
			    SUMX ( CorrTable, [Y] )
			
			VAR SX2 =
			    SUMX ( CorrTable, [X] * [X] )
			
			VAR SY2 =
			    SUMX ( CorrTable, [Y] * [Y] )
			
			VAR SXY =
			    SUMX ( CorrTable, [X] * [Y] )
			
			VAR Num = N * SXY - SX * SY
			VAR Den = SQRT ( ( N * SX2 - SX * SX ) * ( N * SY2 - SY * SY ) )
			
			VAR R = DIVIDE ( Num, Den )
			RETURN
			    IF ( N < 2, BLANK (), R * R )
			
			```
		lineageTag: 0f20205f-2cf0-4dab-8da1-9d3d25ac8678

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales Start Date' =
			
			VAR EndDate =
			    EOMONTH ( MAX ( 'DIM Date'[Full Date] ), 0 )
			VAR StartDate =
			    EOMONTH ( EndDate, -Months[Months Value]-'Offset'[Offset Value] ) + 1
			VAR StopDate =
			    EOMONTH ( EndDate, -'Offset'[Offset Value] )
			RETURN
			StartDate
		formatString: General Date
		lineageTag: 442805d1-c40f-4a28-9f83-598a65475ab6

		changedProperty = Name

	measure 'Sales Stop Date' =
			
			VAR EndDate =
			    EOMONTH ( MAX ( 'DIM Date'[Full Date] ), 0 )
			VAR StartDate =
			    EOMONTH ( EndDate, -Months[Months Value]-'Offset'[Offset Value] ) + 1
			VAR StopDate =
			    EOMONTH ( EndDate, -'Offset'[Offset Value] )
			RETURN
			StopDate
		formatString: General Date
		lineageTag: da2ed4ba-3f4c-4435-991e-4e87a58c0f79

		changedProperty = Name

