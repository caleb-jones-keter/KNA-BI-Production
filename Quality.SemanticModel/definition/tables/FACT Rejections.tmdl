	measure MinDate =
			
			VAR EndDate =
			    EOMONTH ( MAX ( 'DIM Date'[Full Date] ), 0 )
			VAR StartDate =
			    EDATE ( EndDate, -Months[Months Value] )
			VAR Reasons = { "39", "178", "232", "241" }
			RETURN
			    CALCULATE (
			        MIN ( 'FACT Rejections'[DateKey_daily] ),
			        'FACT Rejections'[OrderReasonKey] IN Reasons,
			        'FACT Rejections'[DateKey_daily] >= StartDate,
			        'FACT Rejections'[DateKey_daily] <= EndDate
			    )
		formatString: 0
		lineageTag: 1ed08ab6-0432-4555-8f1d-e5633dd315bf

		changedProperty = Name

	measure 'Months with RTV' = ```
			
			COUNTROWS (
			    FILTER (
			        VALUES ( 'DIM Date'[FOM] ),
			        NOT ISBLANK ( [RTV (M)] )
			    )
			)
			
			```
		formatString: 0
		lineageTag: 513133ec-4694-4e1a-8066-27def78a2b44

