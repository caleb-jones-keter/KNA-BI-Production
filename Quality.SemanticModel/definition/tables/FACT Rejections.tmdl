	measure 'Rejections Filter' = IF([RTV (M)]>0,"Has Rejections")
		lineageTag: cdbf3179-eac4-4c1f-9b8f-bc71d73fe400

		changedProperty = Name

	measure 'Estimated RTV SKU Group' =
			
			VAR Known =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( 'DIM Product'[Dim Products.SKU Group # & Desc] ),
			            "X", CALCULATE ( [TL %] ),
			            "Y", CALCULATE ( [RTV %] )
			        ),
			        NOT ( ISBLANK ( [X] ) )
			            && NOT ( ISBLANK ( [Y] ) )
			    )
			
			VAR Count_Items =
			    COUNTROWS ( Known )
			
			VAR Sum_X =
			    SUMX ( Known, [X] )
			
			VAR Sum_X2 =
			    SUMX ( Known, [X] * [X] )
			
			VAR Sum_Y =
			    SUMX ( Known, [Y] )
			
			VAR Sum_XY =
			    SUMX ( Known, [X] * [Y] )
			
			VAR Average_X =
			    DIVIDE ( Sum_X, Count_Items )
			
			VAR Average_Y =
			    DIVIDE ( Sum_Y, Count_Items )
			
			VAR Slope =
			    DIVIDE (
			        Count_Items * Sum_XY - Sum_X * Sum_Y,
			        Count_Items * Sum_X2 - Sum_X * Sum_X
			    )
			
			VAR Intercept =
			    Average_Y - Slope * Average_X
			
			RETURN
			    Intercept + Slope * [TL %]
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 975a76bc-5406-4115-ae24-18bccb4d843a

		changedProperty = Name

		changedProperty = FormatString

