table 'FACT Rejections'
	lineageTag: 3978d18d-f655-4787-baad-566084104d94
	sourceLineageTag: [dbo].[FACT Rejections]

	measure 'RTV (M)' = ```
			
			VAR EndDate = EOMONTH ( MAX ('DIM Date'[Full Date] ),0)
			VAR DateWindow = DATESINPERIOD ( 'DIM Date'[Full Date], EndDate, -Months[Months Value], MONTH )
			VAR Reasons = { "39", "178", "232", "241" }
			RETURN
			    - CALCULATE (
			        SUM ( 'FACT Rejections'[Rejections USD] ),
			        'FACT Rejections'[OrderReasonKey] IN Reasons,
			        DateWindow
			    )
			
			```
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: de67dee1-08b6-42c2-9c74-910113e951cc

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Gross Sales (M,O)' = CALCULATE(SUM('FACT Rejections'[Gross Sales USD]),DATESINPERIOD('DIM Date'[Full Date],ENDOFMONTH('DIM Date'[Full Date]),-Months[Months Value]-'Offset'[Offset Value],MONTH))- CALCULATE(SUM('FACT Rejections'[Gross Sales USD]),DATESINPERIOD('DIM Date'[Full Date],ENDOFMONTH('DIM Date'[Full Date]),-'Offset'[Offset Value],MONTH))
		formatString: \$#,0;(\$#,0);\$#,0
