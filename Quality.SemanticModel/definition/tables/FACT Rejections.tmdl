	measure 'Months with RTV 2' =
			
			VAR EndDate =
			    EOMONTH ( MAX ( 'DIM Date'[Full Date] ), 0 )
			VAR DateWindow =
			    DATESINPERIOD (
			        'DIM Date'[Full Date],
			        EndDate,
			        -Months[Months Value],
			        MONTH
			    )
			RETURN
			    COUNTROWS (
			        FILTER (
			            CALCULATETABLE (
			                VALUES ( 'DIM Date'[FOM] ),
			                DateWindow
			            ),
			            NOT ISBLANK ( 'FACT Rejections'[Rejections] )
			        )
			    )
		formatString: 0
		lineageTag: 408a207e-5a91-4993-bdf0-da39de203fdb

		changedProperty = Name

