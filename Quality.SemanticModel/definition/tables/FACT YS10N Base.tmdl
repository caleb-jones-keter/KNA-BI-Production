	measure 'Sales Rows Visible (DateWindow only)' = ```
			
			VAR EndDate   = EOMONTH ( MAX ( 'DIM Date'[Full Date] ), 0 )
			VAR StartDate = EOMONTH ( EndDate, -15 ) + 1
			VAR StopDate  = EOMONTH ( EndDate, -3 )
			RETURN
			CALCULATE (
			    COUNTROWS ( 'FACT YS10N Base' ),
			    DATESBETWEEN ( 'DIM Date'[Full Date], StartDate, StopDate )
			)
			
			```
		formatString: 0
		lineageTag: 97020921-ee53-4325-84de-a7aec5674ec6

		changedProperty = Name

	measure 'R² RTV % vs TL % SKU Group' = ```
			
			VAR CorrTable =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( 'DIM Product'[Dim Products.SKU Group # & Desc] ),
			            "X", CALCULATE ( [TL %] ),
			            "Y", CALCULATE ( [RTV %] )
			        ),
			        NOT ISBLANK ( [X] ) && NOT ISBLANK ( [Y] )
			    )
			
			VAR N =
			    COUNTROWS ( CorrTable )
			
			VAR SX =
			    SUMX ( CorrTable, [X] )
			
			VAR SY =
			    SUMX ( CorrTable, [Y] )
			
			VAR SX2 =
			    SUMX ( CorrTable, [X] * [X] )
			
			VAR SY2 =
			    SUMX ( CorrTable, [Y] * [Y] )
			
			VAR SXY =
			    SUMX ( CorrTable, [X] * [Y] )
			
			VAR Num = N * SXY - SX * SY
			VAR Den = SQRT ( ( N * SX2 - SX * SX ) * ( N * SY2 - SY * SY ) )
			
			VAR R = DIVIDE ( Num, Den )
			RETURN
			    IF ( N < 2, BLANK (), R * R )
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 885bf991-f721-4896-87cd-c58c0dedf069

		changedProperty = Name

		changedProperty = FormatString

