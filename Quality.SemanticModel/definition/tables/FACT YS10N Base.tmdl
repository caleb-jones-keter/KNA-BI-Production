	measure 'R² RTV vs Sales' =
			
			VAR CorrTable =
			    FILTER (
			        SELECTCOLUMNS (
			            ALLSELECTED ( 'DIM Date'[FOM] ),
			            "X", CALCULATE ( [Sales (M,-O)] ),
			            "Y", CALCULATE ( 'FACT Rejections'[RTV (M)] )
			        ),
			        NOT ISBLANK ( [X] ) && NOT ISBLANK ( [Y] )
			    )
			
			VAR N =
			    COUNTROWS ( CorrTable )
			
			VAR SX =
			    SUMX ( CorrTable, [X] )
			
			VAR SY =
			    SUMX ( CorrTable, [Y] )
			
			VAR SX2 =
			    SUMX ( CorrTable, [X] * [X] )
			
			VAR SY2 =
			    SUMX ( CorrTable, [Y] * [Y] )
			
			VAR SXY =
			    SUMX ( CorrTable, [X] * [Y] )
			
			VAR Num = N * SXY - SX * SY
			VAR Den = SQRT ( ( N * SX2 - SX * SX ) * ( N * SY2 - SY * SY ) )
			
			VAR R = DIVIDE ( Num, Den )
			RETURN
			    IF ( N < 2, BLANK (), R * R )
		lineageTag: af33f02d-8fa9-49e7-a5dc-ca92418a4f3d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

