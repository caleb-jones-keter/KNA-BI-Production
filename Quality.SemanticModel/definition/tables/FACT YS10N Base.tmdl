	measure 'Sales (M,-O)' =
			
			VAR EndDate =
			    EOMONTH ( MAX ( 'DIM Date'[Full Date] ), 0 )
			VAR StartDate =
			    EOMONTH ( EndDate, -Months[Months Value]-'Offset'[Offset Value] ) + 1
			VAR StopDate =
			    EOMONTH ( EndDate, -'Offset'[Offset Value] )
			RETURN
			    CALCULATE (
			        SUM ( 'FACT YS10N Base'[Gross Sales USD] ),
			        DATESBETWEEN ( 'DIM Date'[Full Date], StartDate, StopDate )
			    )
		formatString: \$#,0;(\$#,0);\$#,0
		lineageTag: 37dd6068-bdd1-4f05-9ca8-48aaff9d3441

		changedProperty = Name

		changedProperty = FormatString

