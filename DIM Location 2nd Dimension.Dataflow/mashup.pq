[StagingDefinition = [Kind = "FastCopy"]]
section Section1;
[DataDestinations = {[Definition = [Kind = "Reference", QueryName = "Dim Location Dimension 2_DataDestination", IsNewTarget = true], Settings = [Kind = "Automatic", TypeSettings = [Kind = "Table"]]]}]
shared #"Dim Location Dimension 2" = let
    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Name = _t, Code = _t, Latitude = _t, Longitude = _t, #"Target DOS" = _t, #"General Location" = _t, Order = _t]),
    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Name", type text}, {"Code", type text}, {"Latitude", type number}, {"Longitude", type number}, {"Target DOS", Int64.Type}, {"Order", Int64.Type}}),
  #"Added custom" = Table.TransformColumnTypes(Table.AddColumn(#"Changed Type", "Full Name", each [Code] & "-" & [Name]), {{"Full Name", type text}}),
  #"Changed column type" = Table.TransformColumnTypes(#"Added custom", {{"General Location", type text}})
in
    #"Changed column type";
shared #"Dim Location Dimension 2_DataDestination" = let
  Pattern = Lakehouse.Contents([HierarchicalNavigation = null, CreateNavigationProperties = false, EnableFolding = false]),
  Navigation_1 = Pattern{[workspaceId = "8e2b746d-3224-4a82-8467-a2800eef337e"]}[Data],
  Navigation_2 = Navigation_1{[lakehouseId = "624ea251-e87f-45d7-8358-a55b3fa46385"]}[Data],
  TableNavigation = Navigation_2{[Id = "Dim Location Dimension 2", ItemKind = "Table"]}?[Data]?
