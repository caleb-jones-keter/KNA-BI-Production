	measure Measure = IF()
		lineageTag: 3ece2630-80a5-4e62-ad8a-efcd4db122f9

	measure '_Budgeted Drayage Savings' = CALCULATE(SUM('FACT Finance'[2025A]),'FACT Finance'[New Category]="Drayage")-CALCULATE(SUM('FACT Finance'[2026B]),'FACT Finance'[New Category]="Drayage")
		lineageTag: 461dd040-fa82-4b09-862f-63f9cf51f43c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Unbudgeted Drayage Savings' = CALCULATE(SUM('FACT Finance'[2026B]),'FACT Finance'[New Category]="Drayage")-CALCULATE(SUM('FACT Finance'[2026A]),'FACT Finance'[New Category]="Drayage")
		lineageTag: 0668fa49-7fbb-4961-926e-e07600f8197c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Budgeted West Coast Whse Savings' = (CALCULATE(SUM('FACT Finance'[2025A]),'FACT Finance'[Code: Account Detail]="451080",'FACT Finance'[Fixed Category]<>"Overflow")-CALCULATE(SUM('FACT Finance'[2026B]),'FACT Finance'[Code: Account Detail]="451080",'FACT Finance'[Fixed Category]<>"Overflow"))+(CALCULATE(SUM('FACT Finance'[2025A]),'FACT Finance'[Code: Account Detail]="472465",'FACT Finance'[Fixed Category]<>"Overflow")-CALCULATE(SUM('FACT Finance'[2026B]),'FACT Finance'[Code: Account Detail]="472465",'FACT Finance'[Fixed Category]<>"Overflow"))
		lineageTag: dcfbb73f-1080-4dcc-a9d9-1369acbb8125

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Measure 2' = (CALCULATE(SUM('FACT Finance'[2025A]),'FACT Finance'[Code: Account Detail]="472465"&&'FACT Finance'[Fixed Category]<>"Overflow")-CALCULATE(SUM('FACT Finance'[2026B]),'FACT Finance'[Code: Account Detail]="472465"&&'FACT Finance'[Fixed Category]<>"Overflow"))
		lineageTag: ab9a6cd2-2acb-4aa9-9e72-0e79c4d47957

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Sum Month Max A/F' =
			
			SUMX(
			    VALUES('FACT Finance'[Month]),
			    VAR ActualVal =
			        CALCULATE( SUM('FACT Finance'[2026A]) )
			    VAR ForecastVal =
			        CALCULATE( SUM('FACT Finance'[2026F]) )
			    RETURN
			        IF( NOT ISBLANK(ActualVal), ActualVal, ForecastVal )
			)
		lineageTag: ab308059-85ad-4308-9209-e95f274c71ed

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Budget Variance' = SUM('FACT Finance'[2026B])-[_Sum Month Max A/F]
		lineageTag: 32d3fee4-bace-4073-bf42-f496342ff93b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Budget Variance %' = (SUM('FACT Finance'[2026B])-[_Sum Month Max A/F])/[_Sum Month Max A/F]
		lineageTag: 853ac32a-7283-4b04-b07d-8aa66897b93c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Max of Month' = CALCULATE(MAX('FACT Finance'[Month]),FILTER(ALL('FACT Finance'),[2026A]>0))
		formatString: 0
		lineageTag: a16d958e-be7a-4270-8268-01125cf93783

		changedProperty = Name

	measure '_2026F YTG' = CALCULATE(SUM('FACT Finance'[2026F]),FILTER(ALL('FACT Finance'[Month]),'FACT Finance'[Month]>[_Max of Month]))
		lineageTag: 3dd0657c-65c2-4a89-afdf-09319d16a68b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _2026F = ```
			
			VAR MaxMonth = [_Max of Month]
			RETURN
			CALCULATE(
			    SUM('FACT Finance'[2026F]),
			    FILTER(
			        'FACT Finance',
			        'FACT Finance'[Month] > MaxMonth
			    )
			)
			
			```
		lineageTag: ff54e01c-9a5b-428b-9908-cfc6756c77ae

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_2026B YTG' = CALCULATE(SUM('FACT Finance'[2026B]),FILTER(ALL('FACT Finance'[Month]),'FACT Finance'[Month]>[_Max of Month]))
		lineageTag: af7c8129-9da8-456e-8db8-34b4b3411de5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_2026B Pallets YTD' = ```
			
			VAR MaxMonth =
			    MAX('FACT Finance'[Month])
			RETURN
			CALCULATE(
			    SUM('FACT Finance'[2026B]),
			    FILTER(
			        ALL('FACT Finance'),
			        'FACT Finance'[Month] <= MaxMonth &&
			        'FACT Finance'[Account Detail.1] = "Pallets Sold" && 
			        'FACT Finance'[BA-Level4-Posting Level] IN VALUES('FACT Finance'[BA-Level4-Posting Level])
			    )
			)
			```
		lineageTag: 5e618b98-c6bd-4e13-bb0e-cebf806b3ebc

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_2026B YTD' =
			
			VAR MaxMonth =
			    MAX('FACT Finance'[Month])
			RETURN
			CALCULATE(
			    SUM('FACT Finance'[2026B]),
			    'FACT Finance'[Month] <= MaxMonth,
			    ISBLANK('FACT Finance'[Exclusion])
			)
		lineageTag: 6154a612-9e6d-480b-8d73-7a1a35f9302d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_2026A YTD' =
			
			VAR MaxMonth =
			    MAX('FACT Finance'[Month])
			RETURN
			CALCULATE(
			    SUM('FACT Finance'[2026A]),
			    'FACT Finance'[Month] <= MaxMonth,
			    ISBLANK('FACT Finance'[Exclusion])
			)
		lineageTag: 9a586861-11dc-40f3-bff2-2b7845e32954

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_2026F YTD' = ```
			
			VAR MaxMonth =
			    MAX('FACT Finance'[Month])
			VAR OtherMax = 
			    CALCULATE(MAX('FACT Finance'[Month]),FILTER(ALL('FACT Finance'),[2026A]>0))
			RETURN
			CALCULATE(
			    SUM('FACT Finance'[2026F]),
			    'FACT Finance'[Month] <= MaxMonth,
			    ISBLANK('FACT Finance'[Exclusion]),
			    'FACT Finance'[Month] > OtherMax
			)
			```
		lineageTag: ce8110f7-ea8f-4cb0-b543-fe12620eaaf8

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_2026AF YTD' = [_2026A YTD]+[_2026F YTD]
