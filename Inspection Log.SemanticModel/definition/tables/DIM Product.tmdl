table 'DIM Product'
	lineageTag: fe848284-1be3-4d42-8a3d-83faa565ec40
	sourceLineageTag: [dbo].[DIM Product]

	measure Recycle = CALCULATE(SUM('Savannah - Container-Defects'[DefectQuantity]),FILTER('Savannah - Container-Defects','Savannah - Container-Defects'[DefectDisposition]="Recycle"))
		formatString: 0
		lineageTag: 289828da-dec3-494e-9363-0371a6550b13

		changedProperty = Name

	measure Donate = CALCULATE(SUM('Savannah - Container-Defects'[DefectQuantity]),FILTER('Savannah - Container-Defects','Savannah - Container-Defects'[DefectDisposition]="Donate"))
		formatString: 0
		lineageTag: 0b2f0ef3-2133-4043-8f1d-bd8e45df703c

		changedProperty = Name

	measure Defects = [Recycle]+[Donate]
		formatString: 0
		lineageTag: 19de992b-13f3-4b0a-ad1e-15c109cffb78

		changedProperty = Name

	measure '4674 Inbounds' = CALCULATE(SUM('FACT MB51 Material_Movements Initial'[Combined Qty]),FILTER('FACT MB51 Material_Movements Initial','FACT MB51 Material_Movements Initial'[Movement Type] = "311" && 'FACT MB51 Material_Movements Initial'[Storage Location]="4674"))
		lineageTag: b0c795b5-2f30-4e1f-9922-f50387282f6b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

