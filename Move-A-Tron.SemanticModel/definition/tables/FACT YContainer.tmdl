table 'FACT YContainer'
	lineageTag: 907e0835-b91d-4e41-877d-a9fbfb19d297
	sourceLineageTag: [dbo].[FACT YContainer]

	measure _Counter =
			
			CALCULATE(
			    DISTINCTCOUNTNOBLANK('FACT YContainer'[Container]),
			    ALL('FACT YContainer'),
			        'FACT YContainer'[MRPSKU Key]=MIN('FACT YContainer'[MRPSKU Key]),
			        'FACT YContainer'[Inb.delivery]<=MIN('FACT YContainer'[Inb.delivery]),
			        'FACT YContainer'[Storage Location]=MIN('FACT YContainer'[Storage Location])
			    )
		formatString: 0
		lineageTag: fce7bc5d-b667-412e-9b56-f2b38afcdc48

		changedProperty = Name

	measure '_P3 Containers' = ROUNDUP(DIVIDE(MAX(0,[_Target DOS Qty]-[_INV DHL]),SUM('FACT YContainer'[Combined Qty])),0)
		lineageTag: 2708db26-e594-4fd1-8d48-39acba889cd1

		changedProperty = Name

	measure '_Target DOS Qty' = ROUND(CALCULATE(SUM('DIM Storage Location'[Target DOS]),'DIM Storage Location'[Code]="4674")*([_ADS Numerator Move]/140),0)
		lineageTag: 85e5a913-8568-462c-98d5-d95cf026a419

		changedProperty = Name

	measure '_Yard Aging' = CALCULATE(DISTINCTCOUNT('FACT YContainer'[Container]),'FACT YContainer'[Storage Location]="4673",'FACT YContainer'[Days in Country]>90)
		formatString: 0
		lineageTag: b9f9ab34-4929-4ff0-bd7f-1f16837d9ca0

		changedProperty = Name

	measure '_Depot Aging' = CALCULATE(DISTINCTCOUNT('FACT YContainer'[Container]),'FACT YContainer'[Storage Location]="467N",'FACT YContainer'[Days In Place]>60)+CALCULATE(DISTINCTCOUNT('FACT YContainer'[Container]),'FACT YContainer'[Storage Location]="467P",'FACT YContainer'[Days In Place]>60)
		formatString: 0
		lineageTag: 311bdeea-d0eb-4959-870a-e8f21911baff

		changedProperty = Name

	measure '_Total Aging' = [_Depot Aging]+[_Yard Aging]
		formatString: 0
		lineageTag: 06bd54de-3daa-4d22-9c55-4cd2990915a4

		changedProperty = Name

