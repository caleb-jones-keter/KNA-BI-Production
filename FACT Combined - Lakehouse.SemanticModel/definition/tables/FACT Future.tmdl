table 'FACT Future'
	lineageTag: 1d394f5d-299b-49c0-866e-16e85d72973c
	sourceLineageTag: [dbo].[FACT Future]

	measure '_Future Production Future' =
			CALCULATE(
				SUM('FACT Future'[CombinedQty_per_ContQty]),
			    'FACT Future'[Data Source]="YM6P",
			    'FACT Future'[Storage Location]="Future Production"
			)
		lineageTag: 5fd3f682-d2f6-46f9-b4d5-7a4772a140d6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Excess Containers' = MIN(SUM('FACT Future'[CombinedQty_per_ContQty]),IF(MAX('DIM Product'[Cont_Qty])>0,[_Excess 26 Weeks]/MAX('DIM Product'[Cont_Qty])))
		lineageTag: 5cb443d6-73dd-488f-b556-d50dd0b0dc46

	measure '_$DIPlanned Delivery Date' =
			VAR ReqDate = MAX('FACT Future'[Requested deliv.date])
			VAR ArrDate = [_$DICalcArravDate MAGIC_Lookup]
			RETURN
			IF(ReqDate > ArrDate, ReqDate, ArrDate)
		lineageTag: 1a1b8a58-9bf9-4d76-ba43-90915f8c8303

	measure '_$DI Order Status' =
			IF(
			    NOT(ISBLANK([_$DI LA Date MAGIC_Lookup])),
			    "Sailed",
			    IF(
			        [_$DI CONF CATEGORY MAGIC_Lookup] = "AB",
			        "Pending Keter",
			        IF(
			            AND(
			                NOT(ISBLANK([_$DI Container MAGIC_Lookup])),
			                [_$DI Container MAGIC_Lookup] <> ""
			            ),
			            "Pending Shipment",
			            "Open/Other"
			        )
			    )
			)
		lineageTag: 7d8d02d2-c3b7-4bd7-95c9-22f8e28bcd79

	measure '_$DI Early/LateDirectPO' =
			VAR Diff =
			    [_$DICalcArravDate MAGIC_Lookup] - MAX('FACT Future'[Requested deliv.date])
			RETURN
			    IF(
			        ISBLANK(Diff),
			        "N/A",
			        IF(
			            Diff > 7,
			            "Late",
			            IF(
			                Diff < -7,
			                "Early",
			                "On Time"
			            )
			        )
			    )
		lineageTag: 8438bca7-6293-4602-965d-e9db518b970b

	measure '_$DI Ship-To-PartyName MAGIC_Lookup' =
			VAR CurrentPO = SELECTEDVALUE('FACT Future'[Ship-To Party_1])
			VAR Name1 =
			    LOOKUPVALUE(
			        'DIM Customer'[Sheet1.Name 1_1],
			        'DIM Customer'[Payer Key], CurrentPO
			    )
			RETURN Name1
		lineageTag: a70e7edc-a8f3-493e-a14e-0cbbb27ebb4d

	measure '_DOS Future Size' =
			IF([_INV + TRANS Future]>0,
			
			CALCULATE(MIN(75,[_INV + TRANS Future]/([_ADS Numerator 3M FCST]/140))))
		lineageTag: 0192134c-636c-4fb4-b90b-c7114f1099a2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Carrying Cost of Excess' = [_$ Excess Cogs]*.52*1/365
		lineageTag: 0ddf28e8-4626-413c-94e0-ea5452c8f809

	measure '_Inventory COGS' = SUM('FACT Future'[Stock_Value])/CALCULATE(SUM('FACT Future'[Combined Qty]),'FACT Future'[Data Source]="MB52")
		lineageTag: c0487bf1-d94f-46a6-808b-2fef2b65824e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$ OnTimeCount' =
			CALCULATE(
			    COUNTROWS('FACT Future'),
			    'FACT Future'[Data Source] = "YS10N",
			    FILTER('FACT Future', [_Lost Sales] = 0),
			    ALLEXCEPT('FACT Future', 'FACT Future'[MRPSKU Key])
			)
		formatString: 0
		lineageTag: 7d7c56ae-aa6c-4623-bbde-9709b64390bd

	measure '_$ AtRiskCount' =
			CALCULATE(
			    COUNTROWS('FACT Future'),
			    'FACT Future'[Data Source] = "YS10N",
			    FILTER('FACT Future', [_Lost Sales] > 0),
			    ALLEXCEPT('FACT Future', 'FACT Future'[MRPSKU Key])
			)
		formatString: 0
		lineageTag: 7c9c4a45-574d-46f7-a048-ab1c04169abd

	measure '_$ OnTimePct' = DIVIDE([_$ OnTimeCount], [_$ OnTimeCount] + [_$ AtRiskCount], 0)
		lineageTag: b2e00a12-a727-4a13-894e-2b5041f01575

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$availableqtymtomeasure = sum('FACT Future'[Inv])-sum('FACT Future'[Blocked_Qty])
		formatString: 0
		lineageTag: addbc2a8-0b61-4ef0-b0a1-7062739dad0a

	measure '_$ Net Value at risk' =
			CALCULATE(
			    SUM('FACT Future'[Net Value]),
			    'FACT Future'[Data Source] = "YS10N",
			    'FACT Future'[Lost Sales] > 0
			)
		lineageTag: 8e5f05b6-f213-483a-86dd-050a2adced71

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Excess Containers Alt' =
			MAX(0,
			    SUM('FACT Future'[CombinedQty_per_ContQty])-
			        (SUM('FACT Future'[CombinedQty_per_ContQty])+[_In Transit Future]+[_Haifa Storage Future]-[_Excess Containers]))
		lineageTag: ef705178-0735-45c0-a100-3e55b8dc87ec

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Excess in Trans' = IF([_Excess Containers Alt]>0,[_In Transit Future])
		lineageTag: 45e27cd8-99c2-4ae6-99c3-0dd92009478f

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Carrying Cost of Excess Orig' = [_Inventory COGS]*.75*[_Excess Containers]*MAX('FACT Future'[Cont_Qty])*1/365
		lineageTag: 01d77882-09fb-4354-b1a9-aefca672b40a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Carrying Cost of Excess Alt' = [_Inventory COGS]*.57*[_Total Excess Containers in Country]*MAX('FACT Future'[Cont_Qty])*1/365
		lineageTag: b6a93ef2-1d25-4e58-9e7a-f017f779869a

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _-YS10N =
			CALCULATE(
				-SUM('FACT Future'[Combined Qty]),
			    'FACT Future'[Data Source]="YS10N"
			)
		formatString: 0
		lineageTag: ef153000-87ed-4f5b-98ce-eacf39064b9d

	measure '_$MTO ship to party MAGIC_Lookup' =
			VAR CurrentPO = SELECTEDVALUE('FACT Future'[Ship-To Party_1])
			RETURN
			IF(
			    NOT ISBLANK(CurrentPO),
			    LOOKUPVALUE(
			        'DIM Customer'[Sheet1.Name 1_1],
			        'DIM Customer'[Payer Key],
			        CurrentPO
			    )
			)
		lineageTag: 635ee17f-fda1-438b-a40a-df8223efd8df

	measure '_Actual Lost Sales' = CALCULATE(SUM('FACT Future'[Lost Sales]),'FACT Future'[Data Source]="YS10N",'FACT Future'[Payer Types.TypeKey]<>"1",'FACT Future'[Payer Types.TypeKey]<>"2")
		formatString: 0
		lineageTag: bd7854ab-5432-48d8-8f10-84aa8303d9bd

	measure '_Actual Lost Sales Qty' = CALCULATE(SUM('FACT Future'[Qty Not In Inv]),'FACT Future'[Data Source]="YS10N",'FACT Future'[Payer Types.TypeKey]<>"1",'FACT Future'[Payer Types.TypeKey]<>"2")
		formatString: 0
		lineageTag: d0c1fe9e-61cc-4355-aab2-3a0d7c5a8e05

	measure '_Total Current Containers' =
			SUMX(VALUES('DIM Product'[Material]),
			[_Current Containers])
		lineageTag: 3138770c-d506-46b9-a2e1-3af974d0a589

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_INV 3M FCST Container' =
			VAR ReferenceDate = MIN('DIM Date'[Today])
			VAR EndDate       = MAX('DIM Date'[Full Date])
			RETURN
			CALCULATE(
			    SUM('FACT Future'[CombinedQty_per_ContQty]),
			    DATESBETWEEN('DIM Date'[Full Date], ReferenceDate, EndDate)
			)
		lineageTag: 6ae56231-329e-40ab-826c-866c74b3b2e2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Daily Excess Container' = [_INV 3M FCST Container]-[_Total DOC Target Container]
		lineageTag: cca43ff9-3d34-4b81-bfc1-3e2ea78b3945

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_MB52 Future 3.29.26' =
			CALCULATE(
				SUM('FACT Future'[Combined Qty]),
			    'FACT Future'[Data Source]="MB52",
			    ALL('DIM Date'[Future?])
			)
		formatString: 0
		lineageTag: b380d342-0cb9-4b62-9976-398db318feef

	measure '_$DIFactory PO MAGIC_Lookup' =
			VAR CurrentPO =
			    SELECTEDVALUE('FACT Future'[PO Number])  -- get PO for current row
			VAR Result =
			    CALCULATE(
			        MAX('FACT Future'[PO Number]),
			        TREATAS( { CurrentPO }, 'FACT Future'[Ship-to party's purchase order no_] ),
			        'FACT Future'[Data Source] = "YS10N"  -- filter source table
			    )
			RETURN
			IF( NOT ISBLANK(CurrentPO), Result )
		lineageTag: 8bdc8683-4d90-4215-8d71-f07867880da4

	measure '_$DICalcArravDate MAGIC_Lookup' =
			VAR CurrentPO =
			    SELECTEDVALUE('FACT Future'[PO Number])  -- get PO for current row
			VAR Result =
			    CALCULATE(
			        MAX('FACT Future'[CalcArravDate]),
			        TREATAS( { CurrentPO }, 'FACT Future'[Ship-to party's purchase order no_] ),
			        'FACT Future'[Data Source] = "YS10N"  -- filter source table
			    )
			RETURN
			IF( NOT ISBLANK(CurrentPO), Result )
		formatString: General Date
		lineageTag: 047f9e66-d0b8-4b39-9e6c-f3bcfddf4270

	measure '_$DI LA Date MAGIC_Lookup' =
			VAR CurrentPO =
			    SELECTEDVALUE('FACT Future'[PO Number])  -- get PO for current row
			VAR Result =
			    CALCULATE(
			        MAX('FACT Future'[LA Date]),
			        TREATAS( { CurrentPO }, 'FACT Future'[Ship-to party's purchase order no_] ),
			        'FACT Future'[Data Source] = "YS10N"  -- filter source table
			    )
			RETURN
			IF( NOT ISBLANK(CurrentPO), Result )
		formatString: General Date
		lineageTag: f2101222-6796-4c3f-bb72-b77441db65e3

	measure '_$DI CONF CATEGORY MAGIC_Lookup' =
			VAR CurrentPO =
			    SELECTEDVALUE('FACT Future'[PO Number])  -- get PO for current row
			VAR Result =
			    CALCULATE(
			        MAX('FACT Future'[Confirm. Category]),
			        TREATAS( { CurrentPO }, 'FACT Future'[Ship-to party's purchase order no_] ),
			        'FACT Future'[Data Source] = "YS10N"  -- filter source table
			    )
			RETURN
			IF( NOT ISBLANK(CurrentPO), Result )
		lineageTag: 57f609b2-092b-4ef6-8142-f5f58305237a

	measure '_$DI Container MAGIC_Lookup' =
			VAR CurrentPO =
			    SELECTEDVALUE('FACT Future'[PO Number])  -- get PO for current row
			VAR Result =
			    CALCULATE(
			        MAX('FACT Future'[Container]),
			        TREATAS( { CurrentPO }, 'FACT Future'[Ship-to party's purchase order no_] ),
			        'FACT Future'[Data Source] = "YS10N"  -- filter source table
			    )
			RETURN
			IF( NOT ISBLANK(CurrentPO), Result )
		lineageTag: 29c7d6ce-f05a-4ed9-a825-b9aa27fca937

	measure '_INV 3M FCST TL(Future)' = ```
			
			        VAR ReferenceDate = CALCULATE(MIN('DIM Date'[Full Date]), ALLSELECTED('DIM Date'[Full Date]))
			        VAR EndDate = MAX('DIM Date'[Full Date])
			        RETURN
			            CALCULATE(
			                SUM('FACT Future'[CombinedQty_per_TLQty]),
			                DATESBETWEEN('DIM Date'[Full Date], ReferenceDate, EndDate),
			                'FACT Combined'[Data Source]<>"MB52"
			            )
			```
		lineageTag: cdab0def-d61e-4eab-ad2d-a709cab677ba

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Future TL' =
			
			SUMX(
			    VALUES('FACT Future'[Material]),
			    DIVIDE(
			        CALCULATE(SUM('FACT Future'[Combined Qty])),
			        CALCULATE(MAX('DIM Product'[TL Qty]))
			    )
			)
		lineageTag: f1acd641-012c-402d-848c-af4b0a4c1ec9

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

