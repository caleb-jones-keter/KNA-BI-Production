table 'FACT YS10N Open'
	lineageTag: c0de234e-8b05-4720-b11b-18d636bc477b
	sourceLineageTag: [dbo].[FACT YS10N Open]

	measure '_$ Net value Open' = ```
			
			CALCULATE(
			    SUM('FACT YS10N Open'[Net value]),
			
			    TREATAS(
			        VALUES('FACT EDB Budget- Finance'[Code:Payer _c5_]),
			        'FACT YS10N Open'[Payer]
			    )
			)
			
			```
		lineageTag: fab60a31-a2ae-432d-b45a-45ebe1d426c1

		changedProperty = Name

