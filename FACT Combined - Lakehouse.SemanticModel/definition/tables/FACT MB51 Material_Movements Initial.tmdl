table 'FACT MB51 Material_Movements Initial'
	lineageTag: 9f265798-6e15-4328-8cd2-bdaed38e6fc5
	sourceLineageTag: [dbo].[FACT MB51 Material_Movements Initial]

	measure '_MB51 Sales Cont Qty' = CALCULATE(SUM('FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]),'FACT MB51 Material_Movements Initial'[Movement Type]="601")*-1
		lineageTag: 5251f5b2-cf7a-4aa5-ae30-2d710a1cc842

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total MB51 Sales Containers' =
			
			SUMX(VALUES('DIM MRPSKU'[MRPSKU Key]),
			[_MB51 Sales Cont Qty])
		lineageTag: ab4bc95a-5408-4ed8-9bbd-789ec365cd48

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_INV MB51 Cont' =
			
			VAR ReferenceDate = CALCULATE(MIN('DIM Date'[Full Date]),ALL('DIM Date'[Full Date]))
			VAR EndDate       = MAX('DIM Date'[Full Date])
			RETURN
			CALCULATE(
			    SUM('FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    )
			)
		lineageTag: a5fc3987-22cc-481d-b176-965875f3074c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_MB51 Sales Cont Qty Yesterday' =
			
			CALCULATE(
			    SUM('FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]),
			'FACT MB51 Material_Movements Initial'[Movement Type]="601",
			'DIM Date'[Full Date]=MAX('DIM Date'[Today])-1)*-1
		lineageTag: 5542eae0-1bd5-4ff4-a0de-913af894329e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_MB51 Inbounds Cont Qty Yesterday' =
			
			CALCULATE(
			    SUM('FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]),
			'FACT MB51 Material_Movements Initial'[Movement Type]="311",
			'DIM Date'[Full Date]=MAX('DIM Date'[Today])-1,
			'FACT MB51 Material_Movements Initial'[Combined Qty]>0,
			'DIM Storage Location'[Code]<>"467N",
			'DIM Storage Location'[Code]<>"4672",
			'DIM Storage Location'[Code]<>"4673")
		lineageTag: 34e55daf-da35-4bef-90d8-d83ee53a7e01

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_MB51 Sales Cont Qty L6Wk' = CALCULATE(SUM('FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]),'FACT MB51 Material_Movements Initial'[Movement Type]="601",DATESBETWEEN('DIM Date'[Full Date],MAX('DIM Date'[Today SOW])-42,MAX('DIM Date'[Today SOW])-1))*-1
		lineageTag: 0ed6af0d-4c4d-4f0d-8b62-591e3511c10d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total MB51 Sales Containers L6Wk' =
			
			SUMX(VALUES('DIM MRPSKU'[MRPSKU Key]),
			[_MB51 Sales Cont Qty L6Wk])
		lineageTag: abf0e452-c2bf-42ef-bf53-94bbe0ba5dc6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$containersintolocation =
			calculate(
			    sum('FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]),
			    Filter('FACT MB51 Material_Movements Initial',
			    'FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]>0
			    )
			)
		lineageTag: fdee1ee0-dc2d-426c-8ede-2b4118c9777a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$MB51 received Cont Qty Last 1 Year' =
			
			CALCULATE(
			    SUM('FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]),
			    'FACT MB51 Material_Movements Initial'[Movement Type] = "101",
			    DATESINPERIOD(
			        'DIM Date'[Full Date],
			        MAX('DIM Date'[Full Date]),
			        -1,
			        YEAR
			    )
			) * -1
		lineageTag: 95ed972d-afe2-46d4-9560-b63bf743dcae

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$Weeks With Containers (Last 1 Year)' =
			
			CALCULATE(
			    COUNTROWS(
			        FILTER(
			            VALUES('DIM Date'[SOW]),
			            [_$MB51 received Cont Qty Last 1 Year] > 0
			        )
			    ),
			    DATESINPERIOD(
			        'DIM Date'[Full Date],
			        MAX('DIM Date'[Full Date]),
			        -1,
			        YEAR
			    )
			)
		formatString: 0
		lineageTag: 01bf5e2a-5ba4-412e-80cb-34d917f43a68

		changedProperty = Name

	measure '_Actual Sales Target' =
			
			VAR ReferenceDate = MIN('DIM Date'[SOW])
			VAR EndDate       = ReferenceDate + 'DOC Parameter'[DOC Parameter Value]
			RETURN
			CALCULATE(
			    -SUM('FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    )
			)
		lineageTag: e2a853f9-5732-402c-b684-d3f367ac0b70

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Inbounds Qty Range' =
			
			VAR ReferenceDate = CALCULATE(MIN('DIM Date'[Full Date]),ALLSELECTED('DIM Date'[Full Date]))
			VAR EndDate       = CALCULATE(MAX('DIM Date'[Full Date]),ALLSELECTED('DIM Date'[Full Date]))
			RETURN
			CALCULATE(
			    SUM('FACT MB51 Material_Movements Initial'[Combined Qty]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    ),
			    'FACT MB51 Material_Movements Initial'[Movement Type]="101",
			    'FACT MB51 Material_Movements Initial'[Storage Location]="4672"
			
			)
		lineageTag: 52a9886c-3215-4af3-b582-9a630c75b590

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_MB51 Sales Qty' = CALCULATE(SUM('FACT MB51 Material_Movements Initial'[Combined Qty]),'FACT MB51 Material_Movements Initial'[Movement Type]="601")*-1
		lineageTag: 5f2631bb-226b-4787-8c8c-d71aa31278d9

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_MB51 Inbounds Cont' = CALCULATE(SUM('FACT MB51 Material_Movements Initial'[CombinedQty_per_ContQty]),'FACT MB51 Material_Movements Initial'[Movement Type]="101",'FACT MB51 Material_Movements Initial'[Storage Location]="4672")
		lineageTag: f64b5046-d415-4516-bf4d-bf30068b9d23

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Picks Alt' = ROUNDUP(-SUM('FACT MB51 Material_Movements Initial'[Combined Qty])/SUM('FACT MB51 Material_Movements Initial'[SS/PLT_Qty]),0)
		lineageTag: 2572faca-7c49-42c7-88ba-67599b64e19f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total Picks' = SUMX(VALUES('FACT MB51 Material_Movements Initial'[Number of Material Document]),[_Picks Alt])
		lineageTag: 7dc2e0a0-8fc2-4a2d-ae3d-4e0dc507b658

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

