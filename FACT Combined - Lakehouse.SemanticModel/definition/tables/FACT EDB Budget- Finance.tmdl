table 'FACT EDB Budget- Finance'
	lineageTag: 84e753f7-4240-41d2-8ee7-b98d3635d775
	sourceLineageTag: [dbo].[FACT EDB Budget- Finance]

	measure _$Netsalesqty = ```
			
			
			VAR Payers =
			    VALUES('FACT EDB Budget- Finance'[Code:Payer _c5_])
			
			VAR MRPAreas =
			    VALUES('FACT EDB Budget- Finance'[MRP Area])
			
			RETURN
			CALCULATE(
			    SUM('FACT YS10N Past'[Net Value USD]),
			    TREATAS(Payers, 'FACT YS10N Past'[Payer]),
			    TREATAS(MRPAreas, 'FACT YS10N Past'[MRP Area])
			)
			
			```
		lineageTag: 0a0bad3a-c012-4077-91ec-916eeb79f150

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$Selected Budget Finance' = ```
			
			VAR SelectedColumn =
			    SELECTEDVALUE('_$budgetfinanceparameter'[Parameter Fields])
			
			RETURN
			    SWITCH(
			        SelectedColumn,
			        NAMEOF('FACT EDB Budget- Finance'[3+9 Net Sales]), 
			            SUM('FACT EDB Budget- Finance'[3+9 Net Sales]),
			
			        NAMEOF('FACT EDB Budget- Finance'[6+6 Net Sales]), 
			            SUM('FACT EDB Budget- Finance'[6+6 Net Sales]),
			
			        NAMEOF('FACT EDB Budget- Finance'[9+3 Net Sales]), 
			            SUM('FACT EDB Budget- Finance'[9+3 Net Sales]),
			
			        NAMEOF('FACT EDB Budget- Finance'[Customer Demand Net sales _APO_]), 
			            SUM('FACT EDB Budget- Finance'[Customer Demand Net sales _APO_]),
			
			        NAMEOF('FACT EDB Budget- Finance'[Net Sales - Budget]), 
			            SUM('FACT EDB Budget- Finance'[Net Sales - Budget])
			    )
			```
		lineageTag: 3d5f6158-c69e-4812-9d71-1f78d5f21624

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$VarTobudgetfinance = ```
			
			if( [_$Selected Budget Finance]-[_$Netsalesqty]<0,0,[_$Selected Budget Finance]-[_$Netsalesqty])
			
			
			```
		lineageTag: f94e9923-2e03-4518-b2d2-c689675c2196

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$overunderbudgetfinance = divide([_$Netsalesqty],[_$Selected Budget Finance])
		lineageTag: bc7b5ef7-9bec-4090-b8c9-7fe94e74cbcf

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$RowHighlight finance' = ```
			
			
			
			VAR OverUnder = [_$overunderbudgetfinance]
			
			VAR TodayDate = today()
			
			VAR DaysPassed =
			    DAY(TodayDate)
			
			VAR TotalDaysInMonth =
			    DAY(EOMONTH(TodayDate, 0))
			
			VAR Progress =
			    DIVIDE(DaysPassed, TotalDaysInMonth)
			
			VAR Tolerance = 0.05
			
			VAR LowerBound = MAX(0, Progress - Tolerance-.05)
			Var Middlelowerbound=max(0,Progress-Tolerance)
			VAR UpperBound = MIN(1, Progress + Tolerance)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(OverUnder), "#F78272",
			        OverUnder < LowerBound, "#F78272",
			        OverUnder < Middlelowerbound, "#FFCC00",
			        OverUnder > UpperBound, "#63BE7B",
			        "#FFFFFF"
			    )
			
			```
		lineageTag: cb7c379d-f65b-46e6-bb73-e82e5802ca3c

		changedProperty = Name

	measure '_$Selected Budget Financedaily' = ```
			
			
			CALCULATE (
			    [_$Selected Budget Finance] ,
			    FILTER (
			        ALL ( 'DIM Date' ),
			        'DIM Date'[Year] = MAX ( 'DIM Date'[Year] )
			            && 'DIM Date'[Month] = MAX ( 'DIM Date'[Month] )
			            && 'DIM Date'[Day] = 1
			    )
			)/day(EOMONTH(today(),0))
			
			```
		lineageTag: 1025c67f-358b-4a40-b9d6-9968f166371e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$Selected Budget APO daily' =
			
			
			CALCULATE (
			    sum('FACT EDB Budget- Finance'[Customer Demand Net sales _APO_]),
			    FILTER (
			        ALL ( 'DIM Date' ),
			        'DIM Date'[Year] = MAX ( 'DIM Date'[Year] )
			            && 'DIM Date'[Month] = MAX ( 'DIM Date'[Month] )
			            && 'DIM Date'[Day] = 1
			    )
			)/day(EOMONTH(today(),0))
		lineageTag: 5288f4d6-e01a-4ec6-9e40-6d2a21ef0dd1

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$Selected Budget Budget Daily' =
			
			
			CALCULATE (
			    sum('FACT EDB Budget- Finance'[Net Sales - Budget]),
			    FILTER (
			        ALL ( 'DIM Date' ),
			        'DIM Date'[Year] = MAX ( 'DIM Date'[Year] )
			            && 'DIM Date'[Month] = MAX ( 'DIM Date'[Month] )
			            && 'DIM Date'[Day] = 1
			    )
			)/day(EOMONTH(today(),0))
		lineageTag: dac0ef7c-febb-4620-b0a1-f528a892bd09

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$yaxis = if(SELECTEDVALUE('DIM Product'[AVG Forecast])<=.6,2000000,0)
		formatString: 0
