table 'DIM Date'
	lineageTag: 31df101e-dce6-4555-9a54-eafbc0cedcd0
	sourceLineageTag: [dbo].[DIM Date]
	dataCategory: Time

	measure 'Forecast Horizon + 6 Weeks' = IF(MIN('DIM Date'[Today SOW])>=DATE(2025,01,01),IF(MIN('DIM Date'[Today SOW])<=MIN('DIM Date'[Today])+42,1,0),0)
		formatString: 0
		lineageTag: ca5e67ae-640a-4c01-be03-bea2a95c3b77

		changedProperty = Name

	measure '_Forecast Horizon +- 6 Weeks' = ```
			
			VAR d = MAX('DIM Date'[Full Date])
			VAR t = MAX('DIM Date'[Today])
			RETURN
			IF( ABS( d - t ) <= 42, 1, 0 )
			
			```
		formatString: 0
		lineageTag: 71d58944-5998-4ff6-8d6d-b8736e167760

		changedProperty = Name

