	measure __$ANCHORDATE = ```
			
			    MAX ( 'FACT YM6P'[StartOfWeek_CalcArravDate_Plus7] )
			
			
			```
		formatString: General Date
		lineageTag: e73ecf2a-f0a9-45a5-bcf6-82558030ae7e

		changedProperty = Name

	measure '__$DOC (YM6P Stable)' =
			
			VAR AnchorDate = [__$ANCHORDATE]
			
			RETURN
			IF (
			    NOT ISBLANK ( AnchorDate ),
			    CALCULATE (
			        [_DOC],
			        'DIM Date'[Full Date] = AnchorDate
			    )
			)
		lineageTag: 1e68bfd8-79eb-4bd8-86e4-57888a0dd44a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _MinDate = ```
			
