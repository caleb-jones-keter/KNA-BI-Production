		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$inv-upper = roundup( ( [__$inv (YM6P Stable)]-[__$upper (YM6P Stable)])/max( 'FACT YM6P'[Order Quantity]),0)
		lineageTag: 0aac907d-48fb-46bf-8271-37c0bd78293a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$finalreview = if([_Counter]>0,if([_$inv-upper]>=[_Counter],"Review Container"))
		lineageTag: ce4293c2-62d5-4cf5-8453-4b92697e1423

		changedProperty = Name

