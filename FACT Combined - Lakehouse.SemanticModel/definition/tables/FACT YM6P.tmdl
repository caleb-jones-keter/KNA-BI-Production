	measure _$%check = [_$orderneedreview]/[_$Distinct Orders by ABC]
		lineageTag: 9c2fc98d-5a21-46a2-963e-135dd5d2b08d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '__$upper (YM6P Stable)' =
			
			VAR AnchorDate = [__$ANCHORDATE]-7
			
			RETURN
			IF (
			    NOT ISBLANK ( AnchorDate ),
			    CALCULATE (
			        [_DOC Target Cont]+max('FACT YM6P'[Order Quantity]),
			        'DIM Date'[Full Date] = AnchorDate
			    )
			)
		lineageTag: f9024633-7bc2-40fd-a28e-bd21e2ebed20

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '__$inv (YM6P Stable)' =
			
			VAR AnchorDate = [__$ANCHORDATE]
			
			RETURN
			IF (
			    NOT ISBLANK ( AnchorDate ),
			    CALCULATE (
			        [_INV 3M FCST],
			        'DIM Date'[Full Date] = AnchorDate
			    )
			)
		formatString: 0
		lineageTag: 2e2ab6fd-51a2-41be-959a-7bf6eaef7479

		changedProperty = Name

	measure _Counter = ```
			
			VAR vMaterial =
			    MAX('FACT YM6P'[Material])
			VAR vPONumber =
			    MAX('FACT YM6P'[PO Number])
			VAR vCalcDate = 
			    MAX('FACT YM6P'[SOW])
			RETURN
			IF (
			    [_$Review SKU]="Review SKU",
			    CALCULATE (
			        DISTINCTCOUNT ( 'FACT YM6P'[PO Number] ),
			        FILTER (
			            ALL('FACT YM6P'),
			            'FACT YM6P'[Material] = vMaterial
			                && 'FACT YM6P'[PO Number] <= vPONumber
			                && 'FACT YM6P'[SOW] = vCalcDate
			        )
			    )
			)
			
			```
		formatString: 0
		lineageTag: dcdd8dd2-4b9a-4f08-a034-6eddaf74c218

		changedProperty = Name

	measure 'Measure 6' = MAX('FACT YM6P'[PO Number])/1
		formatString: 0
		lineageTag: cc34a585-4fd1-47e6-81d7-f01735adca04

