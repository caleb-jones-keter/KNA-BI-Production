	measure '_In Transit Value EOM' =
			
			VAR AsOfDate =
			    EOMONTH ( MAX ( 'DIM Date'[Full Date] ), 0 )
			RETURN
			    CALCULATE (
			        SUM ( 'FACT YM6P'[Net Order Value]),
			
			        -- Remove the active Combined Date relationship filter from the Date table
			        REMOVEFILTERS ( 'DIM Date' ),
			
			        -- Product has shipped by month end
			        KEEPFILTERS (
			            'FACT YM6P'[Ship Date] <= AsOfDate
			                && NOT ISBLANK ( 'FACT YM6P'[Ship Date] )
			        ),
			
			        -- Product has not arrived in the US by month end
			        KEEPFILTERS (
			            'FACT YM6P'[Combined Date] > AsOfDate
			                || ISBLANK ( 'FACT YM6P'[Combined Date] )
			        )
			    )
		lineageTag: f478ed60-a73a-421d-8838-3727797aee23

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_In Transit KG EOM' = ```
			
			VAR AsOfDate =
			    EOMONTH ( MAX ( 'DIM Date'[Full Date] ), 0 )
			
			RETURN
			    CALCULATE (
			        SUMX (
			            'FACT YM6P',
			            DIVIDE (
			                'FACT YM6P'[Combined Qty],
			                RELATED ( 'DIM Product'[Carton/Bag_Qty] )
			            )
			                * RELATED ( 'DIM Product'[Specs.Carton - Weight] )
			                * 0.453592
			        ),
			
			        REMOVEFILTERS ( 'DIM Date' ),
			
			        KEEPFILTERS (
			            'FACT YM6P'[Ship Date] <= AsOfDate
			                && NOT ISBLANK ( 'FACT YM6P'[Ship Date] )
			        ),
			
			        KEEPFILTERS (
			            'FACT YM6P'[Combined Date] > AsOfDate
			                || ISBLANK ( 'FACT YM6P'[Combined Date] )
			        )
			    )
			
			```
		lineageTag: 55a9a283-680b-474f-b6b9-45e5efcedb2c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _ReceivedCheck =
			
			VAR PO = CONVERT(MAX('FACT YM6P'[PO Number]),STRING)
			RETURN
			CALCULATE(COUNT('FACT MB51 Material_Movements Initial'[Purchasing Order Number]),FILTER('FACT MB51 Material_Movements Initial','FACT MB51 Material_Movements Initial'[Purchasing Order Number] = PO))
		formatString: 0
		lineageTag: 6615aede-24b5-4b79-897c-48d52c80f794

		changedProperty = Name

