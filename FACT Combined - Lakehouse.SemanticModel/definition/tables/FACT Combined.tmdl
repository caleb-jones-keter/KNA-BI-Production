	measure '_Excess Carrying Cost CY FAST' = ```
			
			VAR CurrentYear = YEAR(MAX('DIM Date'[Full Date]))
			VAR TodayYear   = YEAR(MAX('DIM Date'[Today]))
			
			RETURN
			IF(
			    CurrentYear = TodayYear,
			    SUMX(
			        'DIM MRPSKU',   -- ⚠️ no VALUES()
			        VAR Cost = 'DIM MRPSKU'[Cost]
			
			        VAR RefDate = MIN('DIM Date'[Full Date])
			        VAR EndDate = RefDate + 365
			
			        VAR TargetQty =
			            CALCULATE(
			                -SUM('FACT Component Forecast Initial'[Combined Qty]),
			                DATESBETWEEN('DIM Date'[Full Date], RefDate, EndDate)
			            )
			
			        VAR InvQty   = [_INV 3M FCST Qty]   -- assuming already optimized
			        VAR ExcessQty =
			            IF(InvQty > TargetQty, InvQty - TargetQty, 0)
			
			        RETURN
			            Cost * ExcessQty * 0.52 / 365
			    )
			)
			
			
			
			```
		lineageTag: 1ad66273-71e7-48aa-b37a-e9671f2797f9

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Excess Carrying Cost RUNNING FAST' = ```
			
			CALCULATE(
			    [_Excess Carrying Cost CY FAST],
			    FILTER(
			        ALL('DIM Date'),
			        'DIM Date'[Full Date] <= MAX('DIM Date'[Full Date])
			    )
			)
			
			```
		lineageTag: aad50224-ef16-4696-b70c-2f8c9348719b

