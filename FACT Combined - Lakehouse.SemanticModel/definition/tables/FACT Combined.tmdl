table 'FACT Combined'
	lineageTag: 93bce427-f324-4ef9-9b11-24e5fb997895
	sourceLineageTag: [dbo].[FACT Combined]

	measure _7WeekTarget = ```
			
			        CALCULATE(
			            IF(
			                MAX(0, MIN('FACT Combined'[Cont_Qty])) = 0,
			                0,
			                ROUNDUP(
			                    MAX(
			                        0,
			                        (45 * [_Future7WKADS] - [_FutureINV_in_7WKS]) / MAX(0, MIN('FACT Combined'[Cont_Qty]))
			                    ),
			                    0
			                )
			            ),
			            'FACT Combined'[Data Source] <> "MB52"
			        )
			```
		lineageTag: 3172e278-1fda-4207-be49-4c7848c1899e

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _CONTDOS20WK = ```
			
			        CALCULATE(
			            MAX(0, (SUM('FACT Combined'[Cont_Qty])) / [_INV QTY 20WK]),
			            'FACT Combined'[Data Source] <> "MB52"
			        )
			```
		lineageTag: 092b7780-2608-420a-8468-1aa89dcd87aa

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

