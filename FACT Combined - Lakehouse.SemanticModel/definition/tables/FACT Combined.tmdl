	measure '_INV 3M FCST Qty 4674' = ```
			
			        VAR ReferenceDate = CALCULATE(MIN('DIM Date'[Full Date]), ALL('DIM Date'[Full Date]))
			        VAR EndDate = MAX('DIM Date'[Full Date])
			        RETURN
			            CALCULATE(
			                SUM('FACT Combined'[Combined Qty]),
			                DATESBETWEEN('DIM Date'[Full Date], ReferenceDate, EndDate),
			                'FACT Combined'[Data Source]<>"MB52",
			                'DIM Storage Location'[Code]="4674" || 'DIM Storage Location'[Code]="4673"
			            )
			```
		formatString: 0
		lineageTag: 168c6d75-990e-47de-b27d-24d2bb431fd1

		changedProperty = Name

	measure '_Total OOS Range' =
			
			VAR SmallestSelectedDate =
			    CALCULATE (
			        MIN ( 'DIM Date'[Full Date] ),
			        ALLSELECTED ( 'DIM Date'[Full Date] )
			    )
			
			VAR LargestSelectedDate =
			    CALCULATE (
			        MAX ( 'DIM Date'[Full Date] ),
			        ALLSELECTED ( 'DIM Date'[Full Date] )
			    )
			
			VAR SmallestForecastDate =
			    CALCULATE (
			        MIN ( 'FACT Component Forecast Initial'[Combined Date] ),
			        DATESBETWEEN (
			            'DIM Date'[Full Date],
			            SmallestSelectedDate,
			            LargestSelectedDate
			        )
			    )
			
			VAR StartDate =
			    MAX ( SmallestSelectedDate, SmallestForecastDate )
			
			VAR TLQty =
			    MAX ( 'DIM Product'[TL Qty] )
			
			VAR Threshold =
			    TLQty * 0.15
			
			RETURN
			CALCULATE (
			    COUNTROWS ( 'DIM Date' ),
			    FILTER (
			        ALL ( 'DIM Date'[Full Date] ),
			        'DIM Date'[Full Date] >= StartDate
			            && 'DIM Date'[Full Date] <= LargestSelectedDate
			            && [_INV 3M FCST Qty] <= [_DOC Target Qty]*.1
			            && [_DOC Target Qty] > 0
			    )
			)
		formatString: 0
		lineageTag: bdcdac19-7c08-4581-a4ab-3531ec52fdd3

		changedProperty = Name

	measure '_Sales 30D Qty' =
			
			VAR ReferenceDate = TODAY()-30
			VAR EndDate       = today()
			RETURN
			CALCULATE(
			    -SUM('FACT MB51 Material_Movements Initial'[Combined Qty]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    ),
			    'FACT MB51 Material_Movements Initial'[Movement Type]="601"
			
			)
