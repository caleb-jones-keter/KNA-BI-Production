	measure '_DHL Capacity FC' = ```
			
			        CALCULATE(
			            IF(
			                AND(CALCULATE(
			                    DISTINCTCOUNT('DIM MRP Area'[MRP Area]),
			                    'DIM MRP Area'[MRP Area] = "67_4674 - DHL"
			                ) > 0,DISTINCTCOUNTNOBLANK('DIM Product'[PC Business Unit])>0),
			                IF(
			                    DISTINCTCOUNTNOBLANK('FACT Combined'[Material]) > 1,
			                    SWITCH(
			                        TRUE(),
			                        MAX('FACT Combined'[Combined Date]) >= DATE(2025, 10, 20), 1198,
			                        MAX('FACT Combined'[Combined Date]) >= DATE(2025, 10, 13), 1198,
			                        MAX('FACT Combined'[Combined Date]) >= DATE(2025, 10, 6), 1198,
			                        MAX('FACT Combined'[Combined Date]) >= DATE(2025, 9, 29), 1150,
			                        MAX('FACT Combined'[Combined Date]) >= DATE(2025, 9, 22), 1103,
			                        MAX('FACT Combined'[Combined Date]) >= DATE(2025, 8, 30), 1063,
			                        MAX('FACT Combined'[Combined Date]) >= DATE(2025, 8, 1), 930,
			                        870
			                    )
			                )
			            ),
			            'FACT Combined'[Data Source] <> "MB52"
			        )
			```
		formatString: 0
		lineageTag: 91979f3c-7c20-4d89-b2a4-8290dffedeeb

		changedProperty = Name

	measure '_Port Free Days' = ```
			
			     //   CALCULATE(
			       //     IF([_DHL Capacity FC] > 0, [_DHL Capacity FC] + 400),
			        //    'FACT Combined'[Data Source] <> "MB52"
			       // )
			
			CALCULATE(
			    IF(
			        [_DHL Capacity FC] > 0,
			        [_DHL Capacity FC] +
			            IF(
			                MAX('DIM Date'[Full Date]) > DATE(2026, 7, 1),
			                280,
			                400
			            )
			    ),
			    'FACT Combined'[Data Source] <> "MB52"
			)
			```
