	measure '_INV FCST MONTHLY' =
			VAR ReferenceDate = MIN('DIM Date'[Today FOM])
			VAR EndDate       = MAX('DIM Date'[Full Date])
			RETURN
			CALCULATE(
			    SUM('FACT Combined'[Combined Qty]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    ),
			    'FACT Combined'[LH SOURCE] = "FACT Future"
