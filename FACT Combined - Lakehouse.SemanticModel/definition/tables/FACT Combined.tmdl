	measure _HaifaContQty = ```
			
			        CALCULATE(
			            DISTINCTCOUNT('FACT Combined'[PO Number]),
			            'FACT Combined'[Data Source] = "YM6P",
			            'FACT Combined'[Data Source] <> "MB52",
			            ISBLANK('FACT Combined'[LA Date]),
			            NOT(ISBLANK('FACT Combined'[Container])),
			            'FACT Combined'[Combined Date] <= TODAY() + 140
