	measure '_Excess 26 Weeks' = ```
			
			VAR EndDate =
			    today()+270
			
			VAR ForecastQty =
			    CALCULATE(
			        -SUM('FACT Component Forecast Initial'[Combined Qty]),
			        DATESBETWEEN('DIM Date'[Full Date], TODAY(), EndDate)
			    )
			RETURN
			IF(
			    ForecastQty > 0,
			    
			    IF(
			        NOT(ISBLANK([_INV 26 Weeks])),
			        MAX(
			            0,
			            [_INV 26 Weeks] -
			                MAX('Max DOS'[Max DOS]) *
			                ([_ADS Numerator Annual] / [_ADS Days Annual])
			        )
			    ),[_INV 26 Weeks]
			)
			```
		lineageTag: 8ed349c5-b319-49ee-875e-9aec9996dc77

		changedProperty = Name

