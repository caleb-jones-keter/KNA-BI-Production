	measure '_Days Range' = ```
			
			VAR SmallestSelectedDate = CALCULATE(MIN('DIM Date'[Full Date]),ALLSELECTED('DIM Date'[Full Date]))
			VAR LargestSelectedDate = CALCULATE(MAX('DIM Date'[Full Date]),ALLSELECTED('DIM Date'[Full Date]))
			VAR SmallestForecastDate =         
			    CALCULATE(
			        MIN('FACT Component Forecast Initial'[Combined Date]),
			        DATESBETWEEN('DIM Date'[Full Date],
			            SmallestSelectedDate,
			            LargestSelectedDate
			        )
			    )
			VAR LargestForecastDate =         
			    CALCULATE(
			        MAX('FACT Component Forecast Initial'[Combined Date]),
			        DATESBETWEEN('DIM Date'[Full Date],
			            SmallestSelectedDate,
			            LargestSelectedDate
			        )
			    )
			
			VAR StartDate = 
			    MAX(
			        SmallestSelectedDate,
			        SmallestForecastDate
			    )
			VAR EndDate   = 
			    MIN(
			        LargestSelectedDate,
			        LargestForecastDate
			    )
			RETURN
			COUNTROWS(
			    DATESBETWEEN('DIM Date'[Full Date],StartDate,EndDate)
			)
			
			```
		formatString: 0
		lineageTag: d07ee1b3-e1c8-47d1-b4d5-92ca99f5cb55

		changedProperty = Name

