	measure '_ADS Numerator Annual' =
			
			VAR ReferenceDate = DATE(YEAR(TODAY()),1,1)
			VAR EndDate       = DATE(YEAR(TODAY()),12,31)
			RETURN
			
			CALCULATE(
			    -SUM('FACT Component Forecast Initial'[Combined Qty]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    )
			    )
		formatString: 0
		lineageTag: 6c1ce272-5c01-483c-b0f4-999d6bb23659

		changedProperty = Name

	measure '_ADS Days Annual' =
			
			VAR ReferenceDate = DATE(YEAR(TODAY()),1,1)
			VAR EndDate       = DATE(YEAR(TODAY()),12,31)
			RETURN
			CALCULATE(
			    DISTINCTCOUNTNOBLANK('FACT Component Forecast Initial'[SOW]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    )
			)*7
		formatString: 0
		lineageTag: 168255c4-3738-4211-be71-39e2464e659c

		changedProperty = Name

	measure '_ADS Numerator 3M FCST' =
			
			VAR ReferenceDate = CALCULATE(
			            MIN('DIM Date'[Full Date]),
			            'FACT Combined'[Data Source]<>"YS10N"
			        )+1
			VAR EndDate = ReferenceDate + 139
			RETURN
			CALCULATE(
			    SUM('FACT Combined'[Combined Qty]),
			    FILTER(
			        ALLSELECTED('FACT Combined'),
			        'FACT Combined'[Combined Date] >= ReferenceDate &&
			        'FACT Combined'[Combined Date] <= EndDate &&
			        'FACT Combined'[Data Source] = "EDB APO" &&
			        'FACT Combined'[MRPSKU Key] in VALUES('FACT Combined'[MRPSKU Key])
			    ))*-1
		formatString: 0
		lineageTag: 982f0bc2-9266-4bbf-a721-a0be301229b0

		changedProperty = Name

