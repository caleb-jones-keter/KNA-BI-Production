	measure '_Actual Days of Coverage' = ```
			VAR ReferenceDate = Min('DIM Date'[SOW])
			VAR EndDate       = ReferenceDate + 365
			VAR FirstFutureDate =
			    CALCULATE(
			        MIN('FACT Combined'[Combined Date]),
			        DATESBETWEEN(
			            'DIM Date'[Full Date],
			            ReferenceDate,
			            EndDate
			        ),
			        'FACT Combined'[Inv] = 0,
			        'FACT Combined'[Qty Not In Inv] <> 0,
			        'FACT Combined'[LH SOURCE] = "FACT Future"
			        
			    )
			VAR DaysCoverage =
			    FirstFutureDate - ReferenceDate
			RETURN
			IF(
			    [_ADS Numerator 3M FCST] > 0,
			    IF(
			        ISBLANK(FirstFutureDate),
			        365,                     -- Large number when no date found
			        MAX(DaysCoverage, 0)     -- Clamp negative values to 0
			    )
			)
			```
		lineageTag: eb7081a7-d4e1-43cc-842e-97674fe6bcf5

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Actual Days of Coverage 49 day Offset' =
			VAR ReferenceDate = Min('DIM Date'[SOW])
			VAR EndDate       = ReferenceDate + 365
			VAR FirstFutureDate =
			    CALCULATE(
			        MIN('FACT Combined'[Combined Date]),
			        DATESBETWEEN(
			            'DIM Date'[Full Date],
			            ReferenceDate+49,
			            EndDate
			        ),
			        'FACT Combined'[Inv] = 0,
			        'FACT Combined'[Qty Not In Inv] <> 0,
			        'FACT Combined'[LH SOURCE] = "FACT Future"
			    )
			VAR DaysCoverage =
			    FirstFutureDate - ReferenceDate
			RETURN
			IF(
			    [_ADS Numerator 3M FCST] > 0,
			    IF(
			        ISBLANK(FirstFutureDate),
			        365,                     -- Large number when no date found
			        MAX(DaysCoverage, 0)     -- Clamp negative values to 0
			    )
			)
		lineageTag: 85a8ba13-b0e5-4a95-8661-ebd145c5df94

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_INV 3M FCST' =
			VAR ReferenceDate = MIN('DIM Date'[Today SOW])
