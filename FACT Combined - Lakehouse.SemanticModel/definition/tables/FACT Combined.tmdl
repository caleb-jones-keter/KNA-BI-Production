	measure '_Need PO' = ```
			
			        CALCULATE(
			            IF(
			                MAX('FACT Combined'[Cont_Qty]) > 0,
			                IF(
			                    [_Current DOS in 20WK] > 55,
			                    -1 * MIN(
			                        'FACT Combined'[_ProdContQty],
			                        ROUNDDOWN(([_Current DOS in 20WK] - 55) / [_CONTDOS20WK], 0)
			                    ),
			                    IF(
			                        [_Current DOS in 20WK] < 55,
			                        ROUNDUP(35 / [_CONTDOS20WK], 0)
			                    )
			                ),
			                0
			            ),
			            'FACT Combined'[Data Source] <> "MB52"
			        )
			```
		formatString: #,0
		lineageTag: dc94e6aa-e429-4318-a852-af43a119ac23

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"isDecimal":true}

	measure '_PO STATUS' = ```
			
			        CALCULATE(
			            IF(
			                TODAY() - 6 + 140 > [_MAXFCSTDATE],
			                "Forecast Ends Early",
			                IF(
			                    [_Need PO] < 0,
			                    "Cancel/Push",
			                    IF([_Need PO] > 0, "Write PO")
			                )
			            ),
			            'FACT Combined'[Data Source] <> "MB52"
			        )
			```
		lineageTag: 7a0ce3fe-da3e-4c9b-a5c2-de06464b0934

