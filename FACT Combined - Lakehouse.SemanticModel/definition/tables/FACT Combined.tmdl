		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _Forecast_Curr_Horizon = ```
			
			        VAR StartDate = MIN('DIM Date'[Today])
			        VAR EndDate = StartDate + 140
			        RETURN
			            CALCULATE(
			                -SUM('FACT Combined'[Combined Qty]),
			                'FACT Combined'[Data Source] = "EDB APO",
			                'FACT Combined'[Data Source] <> "MB52",
			                DATESBETWEEN('DIM Date'[Full Date], StartDate, EndDate)
			            )
			```
		lineageTag: e1b98afb-812d-4356-979e-c1955dd0c140

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

