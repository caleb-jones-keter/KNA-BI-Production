	measure '_Days of Coverage' =
			
			VAR StartDate =
			    MIN ( 'DIM Date'[Full Date] )
			
			VAR InventoryQty =
			    [_INV 3M FCST]
			
			VAR DateTableWithCumDemand =
			    ADDCOLUMNS (
			        FILTER (
			            ALLSELECTED ( 'DIM Date'[Full Date] ),
			            'DIM Date'[Full Date] >= StartDate
			        ),
			        "@CumDemand",
			            CALCULATE (
			                [_YS10N + Forecast for DOC],
			                FILTER (
			                    ALLSELECTED ( 'DIM Date'[Full Date] ),
			                    'DIM Date'[Full Date] > StartDate
			                        && 'DIM Date'[Full Date] <= EARLIER ( 'DIM Date'[Full Date] )
			                )
			            )
			    )
			
			VAR RunOutDate =
			    MINX (
			        FILTER ( DateTableWithCumDemand, [@CumDemand] > InventoryQty ),
			        'DIM Date'[Full Date]
			    )
			
			RETURN
			//    IF (
			//        ISBLANK ( RunOutDate ),
			//        BLANK (),
			        DATEDIFF ( StartDate, RunOutDate, DAY )
			//    )
		formatString: 0
		lineageTag: 579a9c98-99b6-4a8f-b5d1-05c9b4e0c6b5

		changedProperty = Name

