	measure '_Total Days with Target' = ```
			
			VAR SmallestSelectedDate = CALCULATE(MIN('DIM Date'[Full Date]),ALLSELECTED('DIM Date'[Full Date]))
			VAR LargestSelectedDate = CALCULATE(MAX('DIM Date'[Full Date]),ALLSELECTED('DIM Date'[Full Date]))
			VAR StartDate = SmallestSelectedDate
			VAR EndDate   = LargestSelectedDate
			VAR DatesToCheck =
			    CALCULATETABLE(
			        VALUES('DIM Date'[Full Date]),
			        REMOVEFILTERS('DIM Date'[Full Date]),
			        'DIM Date'[Full Date] >= StartDate,
			        'DIM Date'[Full Date] <= EndDate
			    )
			
			RETURN
			SUMX(
			    DatesToCheck,
			    Var Tar = CALCULATE([_DOC Target Qty])
			    RETURN INT(Tar > 0)
			)
			
			```
		formatString: 0
		lineageTag: 2931a52b-f926-45cd-b672-a1c49977dfaa

