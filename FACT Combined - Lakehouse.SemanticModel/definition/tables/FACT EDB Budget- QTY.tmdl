table 'FACT EDB Budget- QTY'
	lineageTag: e4c31f03-ee6d-467a-b3ce-671c4aeeba4c
	sourceLineageTag: [dbo].[FACT EDB Budget- QTY]

	measure '_$Selected Budget QTY' = ```
			
			VAR SelectedColumn = SELECTEDVALUE('_$Budget QTY Parameter'[Parameter Fields])
			RETURN
			    SWITCH(
			        SelectedColumn,
			        NAMEOF('FACT EDB Budget- QTY'[3+9 Quantity]), SUM('FACT EDB Budget- QTY'[3+9 Quantity]),
			        NAMEOF('FACT EDB Budget- QTY'[6+6 Quantity]), SUM('FACT EDB Budget- QTY'[6+6 Quantity]),
			        NAMEOF('FACT EDB Budget- QTY'[9+3 Quantity]), SUM('FACT EDB Budget- QTY'[9+3 Quantity]),
			        NAMEOF('FACT EDB Budget- QTY'[Quantity - Budget]), SUM('FACT EDB Budget- QTY'[Quantity - Budget]),
			        Nameof('FACT EDB Budget- QTY'[Customer Demand _APO_]), sum('FACT EDB Budget- QTY'[Customer Demand _APO_])
			    )
			
			```
		formatString: 0
		lineageTag: 7ad1c61e-5d33-4c99-aab3-0bd580b3720d

		changedProperty = Name

	measure '_$Order Qty' =
			
			
			
			
			VAR Payers =
			    VALUES('FACT EDB Budget- QTY'[Code:Payer _c5_])
			
			VAR MRPAreas =
			    VALUES('FACT EDB Budget- QTY'[MRP Area])
			
			RETURN
			CALCULATE(
			    SUM('FACT YS10N Past'[Combined Qty]) * -1,
			    KEEPFILTERS(
			        TREATAS(Payers, 'FACT YS10N Past'[Payer])
			    ),
			    KEEPFILTERS(
			        TREATAS(MRPAreas, 'FACT YS10N Past'[MRP Area])
			    )
			)
		lineageTag: 68904e07-06df-4580-99b8-1048d7ddd022

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$overunderbudget = divide([_$Order Qty],[_$Selected Budget QTY])
		lineageTag: 4a45d8c7-7f97-42c7-a766-617236302261

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$VarTobudget = if( [_$Selected Budget QTY]-[_$Order Qty]<0,0,[_$Selected Budget QTY]-[_$Order Qty])
		lineageTag: ebd8723f-fa72-4972-99a0-6aa12ac34af6

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$vartobudgetcont = ```
			
			
			SUMX(
			    VALUES('DIM Product'[Material]),
			    VAR VarToBudget =
			        CALCULATE([_$VarTobudget])
			    VAR ContQty =
			        CALCULATE(SELECTEDVALUE('DIM Product'[Cont_Qty]))
			    RETURN
			        IF(
			            NOT ISBLANK(ContQty) && ContQty <> 0,
			            VarToBudget / ContQty
			        )
			)
			
			```
		lineageTag: 3520cfe6-7749-43e0-badf-cd1b1bbc971a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$vartobudgettk =
			
			
			SUMX(
			    VALUES('DIM Product'[Material]),
			    VAR VarToBudget =
			        CALCULATE([_$VarTobudget])
			    VAR ContQty =
			        CALCULATE(SELECTEDVALUE('DIM Product'[TL Qty]))
			    RETURN
			        IF(
			            NOT ISBLANK(ContQty) && ContQty <> 0,
			            VarToBudget / ContQty
			        )
			)
		lineageTag: a36af552-4fe1-424e-be47-6a65cabaac92

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$vartovudgetconttk = ```
			
			
			VAR SelectedMeasure =
			    SELECTEDVALUE('_$budgettk/cont parameter'[Parameter Fields])
			
			RETURN
			    SWITCH(
			        SelectedMeasure,
			        NAMEOF('FACT EDB Budget- QTY'[_$vartobudgetcont]), [_$vartobudgetcont],
			        NAMEOF('FACT EDB Budget- QTY'[_$vartobudgettk]),   [_$vartobudgettk]
			    )
			
			```
		lineageTag: a4e0bdde-a459-4886-a662-f8511f006886

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$RowHighlight =
			
			
			
			VAR OverUnder = [_$overunderbudget]
			
			VAR TodayDate = today()
			
			VAR DaysPassed =
			    DAY(TodayDate)
			
			VAR TotalDaysInMonth =
			    DAY(EOMONTH(TodayDate, 0))
			
			VAR Progress =
			    DIVIDE(DaysPassed, TotalDaysInMonth)
			
			VAR Tolerance = 0.05
			
			VAR LowerBound = MAX(0, Progress - Tolerance-.05)
			Var Middlelowerbound=max(0,Progress-Tolerance)
			VAR UpperBound = MIN(1, Progress + Tolerance)
			
			RETURN
			    SWITCH(
			        TRUE(),
			        ISBLANK(OverUnder), "#F78272",
			        OverUnder < LowerBound, "#F78272",
			        OverUnder < Middlelowerbound, "#FFCC00",
			        OverUnder > UpperBound, "#63BE7B",
			        "#FFFFFF"
			    )
		lineageTag: ea4f49de-4f08-4d65-98f2-d7e70250d939

		changedProperty = Name

	measure '_Sum Filter' = SUM('FACT EDB Budget- QTY'[Quantity - Budget])+SUM('FACT EDB Budget- QTY'[3+9 Quantity])+SUM('FACT EDB Budget- QTY'[6+6 Quantity])+SUM('FACT EDB Budget- QTY'[9+3 Quantity])+SUM('FACT EDB Budget- QTY'[Customer Demand _APO_])
		formatString: 0
		lineageTag: ee1089c3-3797-46ae-ad32-c1b835ff1e14

		changedProperty = Name

