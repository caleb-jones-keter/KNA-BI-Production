	measure '_In Transit Today YM6P' =
			
			VAR ReferenceDate = MIN('DIM Date'[Today])
			VAR EndDate       = MAX('DIM Date'[Full Date])
			VAR Transit =
			CALCULATE(
			    SUM('FACT Combined'[Combined Qty]),
			    DATESBETWEEN(
			        'DIM Date'[Full Date],
			        ReferenceDate,
			        EndDate
			    ),
			    'FACT Combined'[Data Source]="YM6P",
			    NOT(ISBLANK('FACT Combined'[Container])),
			    NOT(ISBLANK('FACT Combined'[LA Date]))
			)
			RETURN
			IF([_Vs Target]<1,MAX(0,Transit),Transit)
		formatString: 0
		lineageTag: 8f5b4c45-37ae-4ea7-a131-d28d129eb191

		changedProperty = Name

