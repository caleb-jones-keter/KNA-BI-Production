	measure '_ADS Numerator FCST' =
			
			VAR ReferenceDate = MIN('DIM Date'[Full Date])+1
			VAR EndDate = ReferenceDate + 139
			RETURN
			CALCULATE(
			    SUM('FACT Component Forecast Initial'[CombinedQty_per_ContQty_fcst]),
			    FILTER(
			        ALLSELECTED('FACT Component Forecast Initial'),
			        'FACT Component Forecast Initial'[Combined Date] >= ReferenceDate &&
			        'FACT Component Forecast Initial'[Combined Date] <= EndDate &&
			        'FACT Component Forecast Initial'[MRPSKU Key] in VALUES('DIM MRPSKU'[MRPSKU Key])
			    ))*-1
		formatString: 0
		lineageTag: b1da4dd8-f58c-42c6-85a2-573e1a40841c

		changedProperty = Name

