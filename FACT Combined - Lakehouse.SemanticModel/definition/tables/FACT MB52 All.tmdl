table 'FACT MB52 All'
	lineageTag: 1ce87a13-e0d5-4bc2-8c66-6cf163f9f223
	sourceLineageTag: [dbo].[FACT MB52 All]

	measure '_MB52 All' = SUM('FACT MB52 All'[Combined Qty])
		formatString: 0
		lineageTag: de5a72a3-ece6-4b8f-93f0-a90e5f05882b

		changedProperty = Name

	measure '_MB52 All Container' = IF(MAX('DIM Product'[Cont_Qty])>0,'FACT MB52 All'[_MB52 All]/MAX('DIM Product'[Cont_Qty]))
		lineageTag: 0d490f8b-8363-469c-bfd8-9d3a3054ba90

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total MB52 All Container' = SUMX(VALUES('DIM Product'[Material]),[_MB52 All Container])
		lineageTag: a4d5b872-3523-4446-b5ba-5a7928612329

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Total Invenotry TLs' =
			
			SUMX(
			    VALUES('DIM Product'[Material]),           -- or your SKU/Material key in DIM Product
			    VAR Qty =
			        CALCULATE( SUM('FACT MB52 All'[Combined Qty]) )
			    VAR ContQty =
			        CALCULATE( MAX('DIM Product'[TL Qty]) )
			    RETURN
			        -DIVIDE(Qty, ContQty, 0)
			)
		lineageTag: 8b577afd-270a-40d1-ba1f-7ca5de6d0a94

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_MB52 All COGS No Date' = CALCULATE(SUM('FACT MB52 All'[Stock_Value]),ALL('DIM Date'[Full Date]))
		lineageTag: adb2be7e-6523-4b2c-bba7-ed9c47e719da

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_MB52 All TL' =
			
			SUMX(
			    VALUES('FACT MB52 All'[Material]),
			    DIVIDE(
			        [_MB52 All],
			        MAX('DIM Product'[TL Qty])
			    )
			)
		lineageTag: dd06cf67-d128-4310-8fbd-7ca0624e2c86

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

