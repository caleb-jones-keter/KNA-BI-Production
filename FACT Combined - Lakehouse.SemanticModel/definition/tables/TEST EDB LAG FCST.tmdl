	measure _$weightedaccuracylag2_customer = ```
			
			SUMX(
			    VALUES('DIM Product'[SKU & Desc]),
			    CALCULATE([_LAG 2 Forecast Accuracy %]) *
			    CALCULATE([_$weight_sku_in_customer])
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 3f1e0a52-fdfd-4fb1-989a-0819fcb4d55c

