	measure '_LAG 3 Forecast Accuracy %' = ```
			
			VAR TotalError =
			    SUMX (
			        'TEST EDB LAG FCST',
			        ABS (
			            'TEST EDB LAG FCST'[Lag3 Quantity – _Apo___2025_2026_2027_]
			            - 'TEST EDB LAG FCST'[Quantity__2025_2026_2027_]
			        )
			    )
			
			VAR TotalForecast =
			    SUM ( 'TEST EDB LAG FCST'[Lag3 Quantity – _Apo___2025_2026_2027_] )
			
			RETURN
			    IF (
			        TotalForecast <> 0,
			        MAX ( 0, 1 - DIVIDE ( TotalError, TotalForecast ) ),
			        BLANK ()
			    )
			
			```
		lineageTag: 11918acf-2640-4ab1-82ef-1f45a4476e2c

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

