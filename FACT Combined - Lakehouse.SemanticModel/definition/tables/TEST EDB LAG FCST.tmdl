	measure '_% of Next Level' =
			
			VAR CurrentLevelValue =
			    SUM('TEST EDB LAG FCST'[Quantity__2025_2026_2027_])
			
			RETURN
			SWITCH(
			    TRUE(),
			
			    ISINSCOPE('TEST EDB LAG FCST'[Code:SKU Level _c1_]),
			    DIVIDE(
			        CurrentLevelValue,
			        CALCULATE(
			            CurrentLevelValue,
			            REMOVEFILTERS('TEST EDB LAG FCST'[Code:SKU Level _c1_])
			        )
			    ),
			
			    ISINSCOPE('TEST EDB LAG FCST'[Customer Groups]),
			    DIVIDE(
			        CurrentLevelValue,
			        CALCULATE(
			            CurrentLevelValue,
			            REMOVEFILTERS('TEST EDB LAG FCST'[Customer Groups])
			        )
			    ),
			
			    ISINSCOPE('TEST EDB LAG FCST'[MonthStartDate]),
			    DIVIDE(
			        CurrentLevelValue,
			        CALCULATE(
			            CurrentLevelValue,
			            REMOVEFILTERS('TEST EDB LAG FCST'[MonthStartDate])
			        )
			    )
			)
		lineageTag: 9ecb3f04-d0ca-4339-b472-6d6f96d24838

