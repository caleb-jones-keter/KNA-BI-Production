		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$Forecast Accuracy (dynamic Lag) weight' =
			
			SWITCH(
			    TRUE(),
			
			    -- Leaf level: SKU row should show raw accuracy
			    ISINSCOPE('DIM Product'[SKU & Desc]),
			        [_$Forecast Accuracy (Dynamic Lag)],
			
			    -- Customer subtotal: weighted average of SKU rows
			    ISINSCOPE('TEST EDB LAG FCST'[Payer]),
			        [_$forecast Accuracy (Dynamic Lag) Customer weight],
			
			    -- Grand total: weighted average of customer subtotals
			    SUMX(
			        VALUES('TEST EDB LAG FCST'[Payer]),
			        CALCULATE([_$forecast Accuracy (Dynamic Lag) Customer weight]) *
			        CALCULATE([_$weight_customer_in_total])
			    )
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5b38df77-acfe-4f5c-a27d-f353d9edb131

		changedProperty = Name

		changedProperty = FormatString

	measure '_$Dynamic BIAS' =
			
			DIVIDE(
			    SUMX(
			        VALUES('DIM Product'[PC Business Unit]),
			        VAR BU = 'DIM Product'[PC Business Unit]
			
			        VAR ForecastQty =
			            SWITCH(
			                TRUE(),
			
			                BU IN { "GF NA", "Home NA", "Shelving & Cabinets & Totes NA" },
			                    CALCULATE(SUM('TEST EDB LAG FCST'[Lag2 Quantity – _Apo___2025_2026_2027_])),
			
			                BU IN { "Deck Boxes","Deck Boxes & Leisure", "Lifestyle","Leisure", "Sheds & Buildings", "Tools", "Packout" },
			                    CALCULATE(SUM('TEST EDB LAG FCST'[Lag3 Quantity – _Apo___2025_2026_2027_])),
			
			                BLANK()
			            )
			
			        VAR ActualQty =
			            CALCULATE(SUM('TEST EDB LAG FCST'[Quantity__2025_2026_2027_]))
			
			        RETURN
			            ForecastQty - ActualQty
			    ),
			    SUM('TEST EDB LAG FCST'[Quantity__2025_2026_2027_])
			)
		lineageTag: d562df23-d429-4536-a7fc-192899d855df

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$Dynamic Lag Column Name' =
			
			VAR BU =
			    SELECTEDVALUE('DIM Product'[PC Business Unit])
			
			RETURN
			    SWITCH(
			        TRUE(),
			
			        BU IN { "GF NA", "Home NA", "Shelving & Cabinets & Totes NA" },
			            "Lag2",
			
			        BU IN { "Deck Boxes","Deck Boxes & Leisure", "Lifestyle","Leisure", "Sheds & Buildings", "Tools", "Packout", "Home EU", "Cabinets & Shelving EU", "F & P EU" },
			            "Lag3",
			
			        "N/A"
			    )
		lineageTag: fe92c13e-1ec3-4bb5-a750-62122ea7558d

		changedProperty = Name

