	measure '_$Forecast Accuracy (Dynamic Lag)' =
			
			VAR BU =
			    SELECTEDVALUE('DIM Product'[PC Business Unit])
			RETURN
			    SWITCH(
			        TRUE(),
			
			        BU IN { "GF NA", "Home NA", "Shelving & Cabinets & Totes NA", "Home NA"},
			            [_LAG 2 Forecast Accuracy %],
			
			        BU IN { "Deck Boxes","Deck Boxes & Leisure", "Lifestyle","Leisure", "Sheds & Buildings", "Tools", "Packout" },
			            [_LAG 3 Forecast Accuracy %],
			
			        BLANK()
			    )
		lineageTag: cbdd8084-6e71-488a-99c6-2350dd505604

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$forecast Accuracy (Dynamic Lag) Customer weight' = ```
			
			SUMX(
			    VALUES('DIM Product'[SKU & Desc]),
			    CALCULATE([_$Forecast Accuracy (Dynamic Lag)]) *
			    CALCULATE([_$weight_sku_in_customer])
			)
			
			```
		lineageTag: c7b38be6-f16a-471b-9ed3-616f9fc47d40

