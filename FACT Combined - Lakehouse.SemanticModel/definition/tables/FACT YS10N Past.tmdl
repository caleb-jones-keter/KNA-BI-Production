table 'FACT YS10N Past'
	lineageTag: c34db0dd-453a-4107-9a7a-280b387c7627
	sourceLineageTag: [dbo].[FACT YS10N Past]

	measure '_$Positive combined' =
			
			SUMX(
			    VALUES('FACT YS10N Past'[MRPSKU Key]),
			    CALCULATE(SUM('FACT YS10N Past'[Combined Qty]))
			) * -1
		lineageTag: d3c27da6-e025-4770-9e6c-94e46410b3f7

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$postivecombinedlinegraph = sum('FACT YS10N Past'[Combined Qty])*-1
		lineageTag: cd1bac54-80ba-4040-95c8-a83bad79953e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$  % Positive Combinedlingraph' =
			
			DIVIDE(
			    [_$postivecombinedlinegraph],
			    CALCULATE(
			        [_$postivecombinedlinegraph],
			        ALLSELECTED('FACT YS10N Past'[Shipping type])
			    )
			)
		lineageTag: 726f610f-1659-4af9-98af-23a33742ca55

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$Distinct Orders' =
			
			DISTINCTCOUNT('FACT YS10N Past'[Sales Order])
		formatString: 0
		lineageTag: 5b1251fe-33eb-4710-af5f-c0b513873284

		changedProperty = Name

	measure '_$% Distinct Orders' = ```
			
			DIVIDE(
			    [_$Distinct Orders],
			    CALCULATE(
			       [_$Distinct Orders],
			        ALLSELECTED('FACT YS10N Past'[Shipping type])
			        )
			    )
			
			```
		lineageTag: a7568286-c8c6-46a7-aee2-a8ca2842e479

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$positive container qty' =
			
			
			SUMX(
			    VALUES('DIM Product'[Material]),
			    VAR VarToBudget =
			        CALCULATE([_$Positive combined])
			    VAR ContQty =
			        CALCULATE(SELECTEDVALUE('DIM Product'[Cont_Qty]))
			    RETURN
			        IF(
			            NOT ISBLANK(ContQty) && ContQty <> 0,
			            VarToBudget / ContQty
			        )
			)
		lineageTag: 73ce9ed0-07b2-4402-8adf-368b2c2742f5

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$% container qty' = ```
			
			DIVIDE(
			    [_$positive container qty],
			    CALCULATE(
			       [_$positive container qty],
			        ALLSELECTED('FACT YS10N Past'[Shipping type])
			        )
			    )
			
			```
		lineageTag: 0a9328a4-034e-4578-a589-0283fde9c1b8

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_$positive container qty LTL' = ```
			
			DIVIDE(
			    calculate(
			    [_$positive container qty],'FACT YS10N Past'[Shipping type]="07")
			    
			    
			    ,
			    CALCULATE(
			       [_$positive container qty],
			        ALL('FACT YS10N Past'[Shipping type])
			        )
			    )
			```
		lineageTag: e5406036-e88d-4431-b7a4-55de2e2478a4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _$LTLCONTAINERS =
			calculate(
			    [_$positive container qty],'FACT YS10N Past'[Shipping type]="07")
		lineageTag: 13413b35-1db7-463f-a345-d5a32dacbee4

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Sales $ Gross Range' =
			
			SUM('FACT YS10N Past'[Gross Sales USD])
		lineageTag: 14ad7537-27e9-422f-a6f9-6b92aac7b21e

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Net Sales YS10N' = SUM('FACT YS10N Past'[Net Value USD])
		lineageTag: 594755d9-fe61-4cbf-9cff-20d353b81a48

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Sales Qty YS10N' = -SUM('FACT YS10N Past'[Combined Qty])
		lineageTag: b4bbd596-b0ab-4535-9073-fffa8d1b93e2

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Sales Qty YS10N Non-MTO' = CALCULATE(-SUM('FACT YS10N Past'[Combined Qty]),ISBLANK('DIM Customer'[Payer Types.Type]))
		lineageTag: 3fced87c-61c5-4dac-8e82-e81a87e4e986

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Avg Sales $ Gross Range' = [_Sales $ Gross Range]/[_Sales Qty YS10N]
		lineageTag: b3f673ac-8a5a-4e25-98b7-879f71368f77

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Sales $ Net Range' =
			
			SUM('FACT YS10N Past'[Net Value USD])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 6cd5d193-0b48-4844-b671-5a36ea3109a1

		changedProperty = Name

		changedProperty = FormatString

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '_Avg Sales $ Net Range' = [_Sales $ Net Range]/[_Sales Qty YS10N]
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
