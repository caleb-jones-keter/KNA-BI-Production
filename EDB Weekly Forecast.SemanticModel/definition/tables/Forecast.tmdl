	column 'Retailer Payer.Payer Code'
		dataType: string
		lineageTag: bcb8818c-b8a1-404a-ba0e-cf59d2e1a227
		summarizeBy: none
		sourceColumn: Retailer Payer.Payer Code

		annotation SummarizationSetBy = Automatic

	partition Forecast = m
		mode: import
		source =
				let
				    Source = AnalysisServices.Database("AZBIASTABMP", "EDB_Plus", [TypedMeasureColumns=true, Implementation="2.0"]),
				    Model1 = Source{[Id="Model"]}[Data],
				    Model2 = Model1{[Id="Model"]}[Data],
				    #"Added Items" = Cube.Transform(Model2,
				        {
				            {Cube.AddAndExpandDimensionColumn, "[Dim_Product]", {"[Dim_Product].[ProductKey].[ProductKey]"}, {"Product.SKU Level Code"}},
				            {Cube.AddAndExpandDimensionColumn, "[Dim_Date]", {"[Dim_Date].[DB2DateKey].[DB2DateKey]"}, {"Date.Date (Numeric)"}},
				            {Cube.AddAndExpandDimensionColumn, "[Dim_MrpArea]", {"[Dim_MrpArea].[MRP_CODE].[MRP_CODE]"}, {"Mrp Area.MRP_CODE"}},
				            {Cube.AddMeasureColumn, "Customer Demand (APO)", "[Measures].[NC_Total_Unconstrained_Forecast_Fact_Weekly_Operational_Forecast]"},
				            {Cube.AddAndExpandDimensionColumn, "[Dim_RetailerPayer]", {"[Dim_RetailerPayer].[retailerkey].[retailerkey]"}, {"Retailer Payer.Payer Code"}}
				        })
				in
				    #"Added Items"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

