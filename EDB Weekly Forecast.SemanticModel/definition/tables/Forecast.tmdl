table Forecast
	lineageTag: fa854d29-d636-4aa2-8d20-d0735e517d76

	measure '_$Original Forecast per TL QTY' = ```
			
			SUMX(
			    Forecast,
			    DIVIDE(
			        Forecast[Customer Demand (APO)],
			        LOOKUPVALUE(
			            'DIM Product'[TL Qty],
			            'DIM Product'[Material], Forecast[Product.SKU Level Code]
			        ),
			        0
			    )
			)
			
			```
		lineageTag: ee39beb8-b7ea-493f-93e8-3f09a5172ee7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Product.SKU Level Code'
		dataType: string
		lineageTag: f0bd53a9-30e2-4575-8d7b-bdd0b6295a81
		summarizeBy: none
		sourceColumn: Product.SKU Level Code

		annotation SummarizationSetBy = Automatic

	column 'Date.Date (Numeric)'
