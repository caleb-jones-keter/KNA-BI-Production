[DefaultOutputDestinationSettings = [DestinationDefinition = [Kind = "Reference", QueryName = "DefaultDestination", IsNewTarget = true], UpdateMethod = [Kind = "Replace"], DestinationTypeSettings = [Kind = "Table"]], StagingDefinition = [Kind = "FastCopy"]]
section Section1;
[BindToDefaultDestination = true]
shared #"DIM Storage Location" = let
    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Name = _t, Code = _t, Latitude = _t, Longitude = _t, #"Target DOS" = _t, #"General Location" = _t, Order = _t, Column1 = _t, Column2 = _t]),
    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Name", type text}, {"Code", type text}, {"Latitude", type number}, {"Longitude", type number}, {"Target DOS", Int64.Type}, {"Order", Int64.Type}}),
  #"Added custom" = Table.TransformColumnTypes(Table.AddColumn(#"Changed Type", "Full Name", each [Code] & "-" & [Name]), {{"Full Name", type text}}),
  #"Changed column type" = Table.TransformColumnTypes(#"Added custom", {{"General Location", type text}}),
  #"Duplicated column" = Table.DuplicateColumn(#"Changed column type", "General Location", "General Location - Copy"),
  #"Extracted text before delimiter" = Table.TransformColumns(#"Duplicated column", {{"General Location - Copy", each Text.BeforeDelimiter(_, " - ", 0), type text}}),
  #"Renamed columns" = Table.RenameColumns(#"Extracted text before delimiter", {{"General Location - Copy", "Grouped Location"}}),
  #"Duplicated column 1" = Table.DuplicateColumn(#"Renamed columns", "Name", "Name - Copy"),
  #"Renamed columns 1" = Table.RenameColumns(#"Duplicated column 1", {{"Name - Copy", "Alt Name"}})
in
    #"Renamed columns 1";
shared DefaultDestination = let
  Source = Lakehouse.Contents([HierarchicalNavigation = null, CreateNavigationProperties = false, EnableFolding = false]),
  #"Navigation 1" = Source{[workspaceId = "8e2b746d-3224-4a82-8467-a2800eef337e"]}[Data],
  #"Navigation 2" = #"Navigation 1"{[lakehouseId = "624ea251-e87f-45d7-8358-a55b3fa46385"]}[Data]
in
  #"Navigation 2";
