	measure Inv = SUM('FACT MB52 All'[Blocked])+SUM('FACT MB52 All'[In Quality Insp_])+SUM('FACT MB52 All'[Restricted-Use Stock])+SUM('FACT MB52 All'[Returns])+SUM('FACT MB52 All'[Transit and Transfer])+SUM('FACT MB52 All'[Unrestricted])
