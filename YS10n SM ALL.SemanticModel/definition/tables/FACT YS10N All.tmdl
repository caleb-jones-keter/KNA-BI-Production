table 'FACT YS10N All'
	lineageTag: 4b204e77-a5c1-448d-81b7-54458617ff6a
	sourceLineageTag: [dbo].[FACT YS10N All]

	measure _NetValueShippedMTD =
			
			SUMX(
			    VALUES('DIM Customer'[Customer Groups]),
			    CALCULATE(
			        SUM('FACT YS10N All'[Net value]),
			        DATESMTD('FACT YS10N All'[Ship Date])
			    )
			)
		lineageTag: 1ef6388d-7651-4fd2-a3bf-783163d7f9b8

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure _NetValueOpenCurrentMonth = ```
			
			    CALCULATE(
			        SUM('FACT YS10N All'[Net value]),
			            MONTH('FACT YS10N All'[Combined Date]) = MONTH(TODAY()),
			            YEAR('FACT YS10N All'[Combined Date]) = YEAR(TODAY()),
			            ISBLANK('FACT YS10N All'[Ship Date]),
			            ISBLANK('FACT YS10N All'[Reason for rejection])
			    )
			```
		lineageTag: 127bee10-d37d-4db4-966a-cc9098ccee87

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

