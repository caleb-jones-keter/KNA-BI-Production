table 'FACT RPA Report MPL'
	lineageTag: 409a38ff-bd9e-47e1-8bff-ed2832717af1
	sourceLineageTag: [dbo].[FACT RPA Report MPL]

	measure '_FG Total Previous Year' = ```
			
			CALCULATE(
			    SUM('Finished Goods EDB'[Quantity]),
			
			    -- Remove only date filtering
			    REMOVEFILTERS('Finished Goods EDB'[Daily Date _MM/dd/yyyy_]),
			
			    -- Previous full year
			    YEAR('Finished Goods EDB'[Daily Date _MM/dd/yyyy_]) = YEAR(TODAY()) - 1,
			
			    -- Keep SKU context via bridge
			    TREATAS(
			        VALUES('FACT RPA Report MPL'[Material_Country_Key]),
			        'SP _FG Product Link_'[Material_Country_Key]
			    )
			)
			
			
			
			
			
			
			
			```
		formatString: 0
		lineageTag: 03a18243-ba40-42e0-8e19-2021ed551a22

		changedProperty = Name

	measure '_FG Total YTD' = ```
			
			CALCULATE(
			    SUM('Finished Goods EDB'[Quantity]),
			
			    -- Remove only date filtering
			    REMOVEFILTERS('Finished Goods EDB'[Daily Date _MM/dd/yyyy_]),
			
			    -- YTD logic
			    'Finished Goods EDB'[Daily Date _MM/dd/yyyy_] >= DATE(YEAR(TODAY()), 1, 1),
			    'Finished Goods EDB'[Daily Date _MM/dd/yyyy_] <= TODAY(),
			
			    -- Keep SKU context via bridge
			    TREATAS(
			        VALUES('FACT RPA Report MPL'[Material_Country_Key]),
			        'SP _FG Product Link_'[Material_Country_Key]
			    )
			)
			
			
			
			```
		formatString: 0
		lineageTag: 102c4a1a-cba7-4028-a768-af0aac56c528

		changedProperty = Name

	measure '_FG this year FCST' = ```
			
			CALCULATE(
			    SUM('Finished Goods EDB'[Customer Demand]),
			
			    -- Only override date
			    REMOVEFILTERS('Finished Goods EDB'[Daily Date _MM/dd/yyyy_]),
			
			    -- Force current year
			    YEAR('Finished Goods EDB'[Daily Date _MM/dd/yyyy_]) = YEAR(TODAY()),
			
			    -- Keep SKU context
			    TREATAS(
			        VALUES('FACT RPA Report MPL'[Material_Country_Key]),
			        'SP _FG Product Link_'[Material_Country_Key]
			    )
			)
			
			
			
			
			
			
			
			
			
			```
		formatString: 0
		lineageTag: 901dba24-a17e-4b57-ae0d-e62cdbd1608e

		changedProperty = Name

	measure '_FG-CY Demand Balance' = [_FG this year FCST]-[_FG Total YTD]
		formatString: 0
		lineageTag: 55e878ff-9cff-444a-b54a-60694759f914

		changedProperty = Name

	measure _MaterialStatus_Lookup = ```
			
			LOOKUPVALUE(
			    'SP ZMM02'[MS],                -- Column to return
			    'SP ZMM02'[Material_Country_Key],           -- Column to search in SP ZMM02
			    MAX('FACT RPA Report MPL'[Material_Country_Key]) -- Value to match from FACT RPA Report MPL
			)
			
			
			```
		lineageTag: d0c6402c-99fe-48a6-b824-a78aad5cd870

		changedProperty = Name

	measure '_SPCurrent Inventory' = ```
			
			
			CALCULATE(
			    SUM('FACT MB52 All'[Unrestricted]),
			
			    -- Filter for Plant 68 OR Plant 65 with Storage Location 365A
			    FILTER(
			        'FACT MB52 All',
			        'FACT MB52 All'[Plant] = "68" ||
			        (
			            'FACT MB52 All'[Plant] = "65" &&
			            'FACT MB52 All'[Storage Location] = "365A"
			        )
			    ),
			
			    -- Remove all RPA row context EXCEPT SKU
			    REMOVEFILTERS('FACT RPA Report MPL'),
			    KEEPFILTERS(VALUES('FACT RPA Report MPL'[Spare Part SKU])),
			
			    -- Map SKU → Material
			    TREATAS(
			        VALUES('FACT RPA Report MPL'[Spare Part SKU]),
			        'FACT MB52 All'[Material]
			    )
			)
			
			
			
			
			
			```
		lineageTag: 52e0439d-a248-45fc-87ee-fb1f10d16a9d

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_SP Total Previous Year' =
			
			CALCULATE(
			    SUM('Finished Goods EDB'[Quantity]),
			
			    -- Remove only date filtering
			    REMOVEFILTERS('Finished Goods EDB'[Daily Date _MM/dd/yyyy_]),
			
			    -- Previous full year
			    YEAR('Finished Goods EDB'[Daily Date _MM/dd/yyyy_]) = YEAR(TODAY()) - 1,
			
			    -- Keep SKU context via bridge
			    TREATAS(
			        VALUES('FACT RPA Report MPL'[Spare Part SKU | Country]),
			        'SP _FG Product Link_'[Material_Country_Key]
			    )
			)
		formatString: 0
		lineageTag: 50e32a63-799c-47f4-8b87-c2da6b21d62d

		changedProperty = Name

	measure '_SP Total YTD' =
			
			CALCULATE(
			    SUM('Finished Goods EDB'[Quantity]),
			
			    -- Remove only date filtering
			    REMOVEFILTERS('Finished Goods EDB'[Daily Date _MM/dd/yyyy_]),
			
			    -- YTD logic
			    'Finished Goods EDB'[Daily Date _MM/dd/yyyy_] >= DATE(YEAR(TODAY()), 1, 1),
			    'Finished Goods EDB'[Daily Date _MM/dd/yyyy_] <= TODAY(),
			
			    -- Keep SKU context via bridge
			    TREATAS(
			        VALUES('FACT RPA Report MPL'[Spare Part SKU | Country]),
			        'SP _FG Product Link_'[Material_Country_Key]
			    )
			)
		formatString: 0
		lineageTag: e6af66d9-b715-43c9-8e44-89728f2a374f

		changedProperty = Name

	measure _reorderpoint_Lookup =
			
			LOOKUPVALUE(
			    'SP ZMM02'[Reorder Point],                -- Column to return
			    'SP ZMM02'[Material_Country_Key],           -- Column to search in SP ZMM02
			    MAX('FACT RPA Report MPL'[Material_Country_Key]) -- Value to match from FACT RPA Report MPL
			)
		lineageTag: da1cf036-6937-437f-8b5c-c9e56f481205

		changedProperty = Name

	measure '_FG future (COUNTRY0) FCST' = ```
			
			
			CALCULATE(
			    SUM('Finished Goods EDB'[Customer Demand]),
			    FILTER(
			        ALL('Finished Goods EDB'),
			        'Finished Goods EDB'[Daily Date _MM/dd/yyyy_] >= TODAY()
			    ),
			    TREATAS(
			        VALUES('FACT RPA Report MPL'[Product SKU]),
			        'Finished Goods EDB'[Code:SKU Level _c4_]
			    )
			)
			
			
			```
		formatString: 0
		lineageTag: c99d8d18-e91c-4e85-9d28-b7e7cc437a6e

		changedProperty = Name

	measure _fg_increase_multiplier = sum('FACT RPA Report MPL'[CY Demand])/[_FG Total Previous Year]
		lineageTag: 6c9c20e3-ff27-48b2-842f-136416f63bba

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_SP LY X YOY multipler' = [_SP Total Previous Year]*[_fg_increase_multiplier]
		lineageTag: 1f894b53-68a7-4382-8bb8-70e60390dd40

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

