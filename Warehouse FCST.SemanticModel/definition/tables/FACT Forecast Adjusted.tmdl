table 'FACT Forecast Adjusted'
	lineageTag: 4310aad3-822c-4df4-9a3e-05cef959f872
	sourceLineageTag: [dbo].[FACT Forecast Adjusted]

	measure '_BOM FCST TL' = ```
			
			SUMX(
			    'FACT Forecast Adjusted',
			    DIVIDE(
			        'FACT Forecast Adjusted'[BOM Forecast],
			        RELATED('DIM Product'[TL Qty]),
			        0
			    )
			) * -1
			
			```
		lineageTag: 107475c5-debc-43c6-9eaa-7579875360c7

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_BOM FCST Cont' = ```
			
			SUMX(
			    'FACT Forecast Adjusted',
			    DIVIDE(
			        'FACT Forecast Adjusted'[BOM Forecast],
			        RELATED('DIM Product'[Cont_Qty]),
			        0
			    )
			) * -1
			
			```
		lineageTag: 6b9bb47b-99c5-4426-9f78-98bae441fe74

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_BOM FCST Pallet' = ```
			
			SUMX(
			    'FACT Forecast Adjusted',
			    DIVIDE(
			        'FACT Forecast Adjusted'[BOM Forecast],
			        RELATED('DIM Product'[SS/PLT_Qty]),
			        0
			    )
			) * -1
			
			```
		lineageTag: 5deacdfc-b415-4512-9f87-1ec9ccbdf8e0

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_BOM FCST Carton' =
			
			IF(SUM('DIM Product'[Carton/Bag_Qty])=BLANK(),
			SUM('FACT Forecast Adjusted'[Combined Qty]),
			SUMX(
			    'FACT Forecast Adjusted',
			    DIVIDE(
			        'FACT Forecast Adjusted'[BOM Forecast],
			        RELATED('DIM Product'[Carton/Bag_Qty]),
			        0
			    )
			)) * -1
		lineageTag: 0749c2ae-d048-493e-b654-21f24735e77f

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Positive Combined QTY' = -sum('FACT Forecast Adjusted'[Combined Qty])
		formatString: 0
		lineageTag: d0fca05d-d7fc-419e-96c0-7cc0605d8b8d

		changedProperty = Name

