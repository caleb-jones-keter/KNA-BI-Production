table AdamsLogisticsMb51
	lineageTag: 33724615-bd10-4e42-8d96-69c87a47d5a7
	sourceLineageTag: [dbo].[AdamsLogisticsMb51]

	measure _101QTY = calculate(sum(AdamsLogisticsMb51[Quantity]),AdamsLogisticsMb51[Movement Type]=101)
		formatString: 0
		lineageTag: 9dcd310b-af85-4ac2-8ce1-33e7c09e5284

		changedProperty = Name

	measure _641QTY = ```
			
			
			calculate(sum(AdamsLogisticsMb51[Quantity]),AdamsLogisticsMb51[Movement Type]=641)
			
			
			```
		formatString: 0
		lineageTag: 93c54595-707b-4a50-bb34-5cf57fb062d8

		changedProperty = Name

	measure _varcreatedshipped = [_101QTY]+[_641QTY]+[_311QTY]
		formatString: 0
		lineageTag: 8268f41d-1fda-4f61-a898-3918c59f8f13

		changedProperty = Name

	measure _varcreatedshippedTL =
			
			SUMX(
			    SUMMARIZE(
			        AdamsLogisticsMb51,
			        AdamsLogisticsMb51[Material],
			        AdamsLogisticsMb51[Posting Date]
			    ),
			    [_Scanned in TL] + [_Shipped out TL]+[_311 TL]
			
			)
		lineageTag: 5275f88c-9612-47cc-b0ee-311b4711a3cd

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Scanned in TL' = ```
			
			
			SUMX(
			    SUMMARIZE(
			        AdamsLogisticsMb51,
			        AdamsLogisticsMb51[Material],
			        AdamsLogisticsMb51[Posting Date]
			    ),
			    VAR Qty101 =
			        CALCULATE(
			            SUM(AdamsLogisticsMb51[Quantity]),
			            AdamsLogisticsMb51[Movement Type] = 101
			        )
			    VAR TLQty =
			        CALCULATE(
			            MAX(AdamsMaster[TL Qty])
			        )
			    RETURN
			        DIVIDE(Qty101, TLQty)
			)
			
			
			
			```
		lineageTag: 5a65bbb4-13d5-4971-bfc3-6826ed7b916a

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_Shipped out TL' = ```
			
			
			SUMX(
			    SUMMARIZE(
			        AdamsLogisticsMb51,
			        AdamsLogisticsMb51[Material],
			        AdamsLogisticsMb51[Posting Date]
			    ),
			    VAR Qty641 =
			        CALCULATE(
			            SUM(AdamsLogisticsMb51[Quantity]),
			            AdamsLogisticsMb51[Movement Type] = 641
			        )
			    VAR TLQty =
			        CALCULATE(
			            MAX(AdamsMaster[TL Qty])
			        )
			    RETURN
			        DIVIDE(Qty641, TLQty)
			)
			
			
			```
		lineageTag: c193058b-8605-4e47-9f74-cd92c53ce67b

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure '_TL Tester' = max(AdamsMaster[TL Qty])
		formatString: 0
		lineageTag: a24f4e9b-8941-4b1d-b63c-522a530586fb

		changedProperty = Name

	measure _311QTY = calculate(sum(AdamsLogisticsMb51[Quantity]),AdamsLogisticsMb51[Movement Type]=311)
		formatString: 0
		lineageTag: 109f3029-62ec-4431-a7bc-3a1c8935f0d7

		changedProperty = Name

	measure '_311 TL' =
			
			
			SUMX(
			    SUMMARIZE(
			        AdamsLogisticsMb51,
			        AdamsLogisticsMb51[Material],
			        AdamsLogisticsMb51[Posting Date]
			    ),
			    VAR Qty641 =
			        CALCULATE(
			            SUM(AdamsLogisticsMb51[Quantity]),
			            AdamsLogisticsMb51[Movement Type] = 311
			        )
			    VAR TLQty =
			        CALCULATE(
			            MAX(AdamsMaster[TL Qty])
			        )
			    RETURN
			        DIVIDE(Qty641, TLQty)
			)
		lineageTag: 383e1724-8710-4312-bec7-095bccac9494

		changedProperty = Name

		annotation PBI_FormatHint = {"isGeneralNumber":true}

